---
import type { TocItem } from '../lib/content';

interface Props {
  items: TocItem[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <nav aria-label="On this page">
    <p class="aside-label">On this page</p>
    <ul class="aside-list">
      {items.map((item) => (
        <li class="doc-toc-item">
          <a href={`#${item.id}`}>{item.title}</a>
        </li>
      ))}
    </ul>
  </nav>
)}
