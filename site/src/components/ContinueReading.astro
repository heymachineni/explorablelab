---
import { iconForType, iconToSvg, getIcon } from '../lib/icons';
import { TYPE_LABELS } from '../lib/museum';

interface Props {
  title?: string;
}

const { title = 'Continue reading' } = Astro.props;

const typeIcons: Record<string, string> = {};
for (const type of Object.keys(TYPE_LABELS)) {
  typeIcons[type] = iconToSvg(getIcon(iconForType(type)), 18);
}
const chevronSvg = iconToSvg(getIcon('chevron-right'), 18, 1.75, 'page-row-chevron');
const pageSvg = iconToSvg(getIcon('page'), 18);
---

<section class="home-section continue-section" data-continue-section hidden>
  <h2 class="home-section-title">{title}</h2>
  <ul class="page-rows continue-list" data-continue-list></ul>
</section>

<script is:inline define:vars={{ typeIcons, chevronSvg, pageSvg }}>
  window.__continueIcons = { typeIcons, chevronSvg, pageSvg };
</script>
