---
import { exhibits, displayTitle, typeLabel } from '../lib/museum';
import { databaseRows } from '../lib/workspace';
import { iconForType, iconToSvg, getIcon } from '../lib/icons';

const searchItems = exhibits.map((e) => {
  const row = databaseRows.find((r) => r.slug === e.slug);
  return {
    slug: e.slug,
    title: displayTitle(e),
    type: typeLabel(e),
    typeCode: e.type,
    wing: e.wing,
    hub: row?.hubTitle ?? '',
    href: `/exhibit/${e.slug}`,
  };
});

const typeIconSvgs: Record<string, string> = {};
for (const item of searchItems) {
  if (!typeIconSvgs[item.typeCode]) {
    typeIconSvgs[item.typeCode] = iconToSvg(getIcon(iconForType(item.typeCode)), 18);
  }
}
const chevronSvg = iconToSvg(getIcon('chevron-right'), 18, 1.75, 'page-row-chevron');
const defaultIconSvg = iconToSvg(getIcon('page'), 18);
---

<div class="palette-backdrop" id="palette-backdrop" role="dialog" aria-modal="true" aria-label="Search pages">
  <div class="palette">
    <input
      type="search"
      class="palette-input"
      id="palette-input"
      placeholder="Search"
      autocomplete="off"
      aria-label="Search"
      aria-controls="palette-results"
    />
    <div class="palette-results" id="palette-results" role="listbox" aria-label="Results"></div>
  </div>
</div>

<script is:inline define:vars={{ searchItems, typeIconSvgs, chevronSvg, defaultIconSvg }}>
  const backdrop = document.getElementById('palette-backdrop');
  const input = document.getElementById('palette-input');
  const results = document.getElementById('palette-results');
  let focusIndex = 0;
  let filtered = [];

  function openPalette() {
    backdrop?.classList.add('open');
    if (input) {
      input.value = '';
      input.focus();
    }
    focusIndex = 0;
    render('');
  }

  function closePalette() {
    backdrop?.classList.remove('open');
    focusIndex = 0;
  }

  function render(query) {
    const q = query.trim().toLowerCase();
    filtered = q
      ? searchItems.filter((item) =>
          item.title.toLowerCase().includes(q) ||
          item.slug.includes(q) ||
          item.type.toLowerCase().includes(q) ||
          item.wing.toLowerCase().includes(q) ||
          item.hub.toLowerCase().includes(q)
        )
      : searchItems.slice(0, 10);

    if (!results) return;

    if (!filtered.length) {
      results.innerHTML = '<p class="palette-empty">No results found</p>';
      return;
    }

    results.innerHTML = filtered
      .slice(0, 12)
      .map(
        (item, i) => {
          const icon = typeIconSvgs[item.typeCode] || defaultIconSvg;
          return `
        <button type="button" class="palette-item${i === focusIndex ? ' focused' : ''}" data-href="${item.href}" role="option" aria-selected="${i === focusIndex}">
          <span class="page-row-icon">${icon}</span>
          <span class="page-row-body">
            <span class="palette-item-title">${item.title}</span>
            <span class="palette-item-meta">${item.type}${item.hub ? ` · ${item.hub}` : ` · ${item.wing}`}</span>
          </span>
          ${chevronSvg}
        </button>`;
        }
      )
      .join('');

    results.querySelectorAll('.palette-item').forEach((btn, i) => {
      btn.addEventListener('click', () => {
        window.location.href = btn.getAttribute('data-href');
      });
    });
  }

  document.addEventListener('open-palette', openPalette);

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openPalette();
    }
    if (e.key === 'Escape') closePalette();
    if (!backdrop?.classList.contains('open')) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      focusIndex = Math.min(focusIndex + 1, filtered.length - 1);
      render(input?.value ?? '');
    }
    if (e.key === 'ArrowUp') {
      e.preventDefault();
      focusIndex = Math.max(focusIndex - 1, 0);
      render(input?.value ?? '');
    }
    if (e.key === 'Enter' && filtered[focusIndex]) {
      window.location.href = filtered[focusIndex].href;
    }
  });

  backdrop?.addEventListener('click', (e) => {
    if (e.target === backdrop) closePalette();
  });

  input?.addEventListener('input', () => {
    focusIndex = 0;
    render(input.value);
  });
</script>
