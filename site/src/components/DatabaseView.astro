---
import type { DatabaseRow } from '../types';

interface Props {
  rows: DatabaseRow[];
  title: string;
  lead?: string;
  defaultFilter?: string;
  defaultView?: 'table' | 'list' | 'gallery' | 'board';
  showHubColumn?: boolean;
  showDifficultyColumn?: boolean;
  id?: string;
}

const {
  rows,
  title,
  lead,
  defaultFilter = 'all',
  defaultView = 'table',
  showHubColumn = true,
  showDifficultyColumn = false,
  id = 'database',
} = Astro.props;

const typeFilters = [...new Map(rows.map((r) => [r.type, r.typeLabel])).entries()].sort(
  (a, b) => a[1].localeCompare(b[1]),
);

const boardColumns = Object.entries(
  rows.reduce<Record<string, DatabaseRow[]>>((acc, row) => {
    const key = row.typeLabel;
    acc[key] = acc[key] ?? [];
    acc[key].push(row);
    return acc;
  }, {}),
).sort((a, b) => a[0].localeCompare(b[0]));
---

<section class="database" data-database={id} data-default-view={defaultView}>
  <header class="database-header">
    <div class="database-header-text">
      {title && <h1 class="database-title">{title}</h1>}
      {lead && <p class="database-lead">{lead}</p>}
    </div>
    <div class="database-view-tabs" role="tablist" aria-label="View">
      <button type="button" class="view-tab" data-view="table">Table</button>
      <button type="button" class="view-tab" data-view="list">List</button>
      <button type="button" class="view-tab" data-view="gallery">Gallery</button>
      <button type="button" class="view-tab" data-view="board">Board</button>
    </div>
  </header>

  <div class="database-toolbar">
    <input
      type="search"
      class="database-search"
      id={`${id}-search`}
      placeholder="Filter pages…"
      aria-label="Filter pages"
    />
    <div class="filter-row" id={`${id}-filters`}>
      <button type="button" class="filter-chip active" data-filter="all">All</button>
      {typeFilters.map(([code, label]) => (
        <button type="button" class="filter-chip" data-filter={code}>{label}</button>
      ))}
    </div>
  </div>

  <div class="database-table-wrap" data-view-panel="table">
    <table class="notion-table notion-table--interactive">
      <thead>
        <tr>
          <th>Name</th>
          <th>Summary</th>
          <th>Type</th>
          {showHubColumn && <th>Topic hub</th>}
          {showDifficultyColumn && <th>Level</th>}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr class="database-row" data-type={row.type} data-search={row.searchText}>
            <td>
              <a href={row.href} class="table-link table-link--with-icon">
                <span class="page-icon-sm" aria-hidden="true">{row.typeLabel.charAt(0)}</span>
                {row.title}
              </a>
            </td>
            <td class="table-muted">{row.summary}</td>
            <td><span class="property-pill property-pill--gray">{row.typeLabel}</span></td>
            {showHubColumn && (
              <td>
                {row.hub ? (
                  <a href={`/exhibit/${row.hub}`} class="table-link-muted">{row.hubTitle}</a>
                ) : (
                  <span class="table-muted">—</span>
                )}
              </td>
            )}
            {showDifficultyColumn && (
              <td>{row.difficulty ? <span class="property-pill property-pill--gray">{row.difficulty}</span> : '—'}</td>
            )}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="database-list" data-view-panel="list" hidden>
    {rows.map((row) => (
      <a href={row.href} class="database-list-row" data-type={row.type} data-search={row.searchText}>
        <span class="page-icon-sm" aria-hidden="true">{row.typeLabel.charAt(0)}</span>
        <span class="database-list-main">
          <span class="database-list-title">{row.title}</span>
          <span class="database-list-meta">{row.typeLabel}{row.hubTitle ? ` · ${row.hubTitle}` : ''}</span>
        </span>
        <span class="database-list-summary">{row.summary}</span>
      </a>
    ))}
  </div>

  <div class="database-gallery" data-view-panel="gallery" hidden>
    {rows.map((row) => (
      <a href={row.href} class="gallery-card" data-type={row.type} data-search={row.searchText}>
        <span class="gallery-card-icon" aria-hidden="true">{row.typeLabel.charAt(0)}</span>
        <span class="gallery-card-title">{row.title}</span>
        <span class="gallery-card-summary">{row.summary}</span>
        <span class="gallery-card-meta">
          <span class="property-pill property-pill--gray">{row.typeLabel}</span>
          {row.difficulty && <span class="property-pill property-pill--gray">{row.difficulty}</span>}
        </span>
      </a>
    ))}
  </div>

  <div class="database-board" data-view-panel="board" hidden>
    {boardColumns.map(([label, columnRows]) => (
      <div class="board-column">
        <div class="board-column-head">
          <span class="board-column-title">{label}</span>
          <span class="board-column-count">{columnRows.length}</span>
        </div>
        <div class="board-column-cards">
          {columnRows.map((row) => (
            <a href={row.href} class="board-card" data-type={row.type} data-search={row.searchText}>
              <span class="board-card-title">{row.title}</span>
              <span class="board-card-summary">{row.summary}</span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>

  <p class="database-count" id={`${id}-count`}>{rows.length} pages</p>
</section>

<script is:inline define:vars={{ id, defaultFilter, defaultView }}>
  const root = document.querySelector(`[data-database="${id}"]`);
  if (!root) return;

  const search = root.querySelector(`#${id}-search`);
  const filterBtns = Array.from(root.querySelectorAll('.filter-chip'));
  const tableRows = Array.from(root.querySelectorAll('.database-row'));
  const filterable = Array.from(root.querySelectorAll('[data-search]'));
  const countEl = root.querySelector(`#${id}-count`);
  const viewTabs = Array.from(root.querySelectorAll('.view-tab'));
  const viewPanels = Array.from(root.querySelectorAll('[data-view-panel]'));
  let mode = new URLSearchParams(window.location.search).get('type') || defaultFilter;
  let currentView = root.getAttribute('data-default-view') || defaultView || 'table';

  function visibleCount() {
    const n = filterable.filter((el) => el.style.display !== 'none').length;
    if (countEl) countEl.textContent = `${n} page${n === 1 ? '' : 's'}`;
  }

  function apply() {
    const q = (search?.value ?? '').trim().toLowerCase();
    filterable.forEach((el) => {
      const type = el.getAttribute('data-type') ?? '';
      const hay = el.getAttribute('data-search') ?? '';
      const matchQ = !q || hay.includes(q);
      const matchF = mode === 'all' || type === mode;
      el.style.display = matchQ && matchF ? '' : 'none';
    });
    visibleCount();
  }

  function setFilter(next) {
    mode = next;
    filterBtns.forEach((btn) => {
      btn.classList.toggle('active', (btn.getAttribute('data-filter') ?? 'all') === mode);
    });
    apply();
  }

  function setView(view) {
    currentView = view;
    viewTabs.forEach((tab) => {
      tab.classList.toggle('active', tab.getAttribute('data-view') === view);
    });
    viewPanels.forEach((panel) => {
      panel.hidden = panel.getAttribute('data-view-panel') !== view;
    });
  }

  search?.addEventListener('input', apply);
  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => setFilter(btn.getAttribute('data-filter') ?? 'all'));
  });
  viewTabs.forEach((tab) => {
    tab.addEventListener('click', () => setView(tab.getAttribute('data-view') ?? 'table'));
  });

  setFilter(mode);
  setView(currentView);
</script>
