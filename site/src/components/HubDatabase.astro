---
import PageList from './PageList.astro';
import { rowsForHub } from '../lib/workspace';

interface Props {
  hubSlug: string;
  hubTitle: string;
}

const { hubSlug, hubTitle } = Astro.props;
const rows = rowsForHub(hubSlug);
---

{rows.length > 0 && (
  <section class="hub-pages">
    <h2 class="hub-pages-title">In this topic</h2>
    <p class="hub-pages-lead">{rows.length} readings in {hubTitle}</p>
    <PageList rows={rows} id={`hub-${hubSlug}`} defaultSegment="all" compact={true} />
  </section>
)}
