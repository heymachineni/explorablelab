---
import type { Exhibit } from '../types';
import { displayTitle, typeLabel } from '../lib/museum';

interface Props {
  exhibits: Exhibit[];
  title?: string;
}

const { exhibits, title = 'Linked from' } = Astro.props;
---

{exhibits.length > 0 && (
  <aside>
    <p class="aside-label">{title}</p>
    <ul class="aside-list">
      {exhibits.map((exhibit) => (
        <li>
          <a href={`/exhibit/${exhibit.slug}`} class="aside-link">
            <span class="aside-link-title">{displayTitle(exhibit)}</span>
            <span class="aside-link-meta">{typeLabel(exhibit)}</span>
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}
