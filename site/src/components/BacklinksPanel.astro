---
import { displayTitle, typeLabel } from '../lib/museum';
import type { Exhibit } from '../types';

interface Props {
  exhibits: Exhibit[];
  title?: string;
}

const { exhibits, title = 'Backlinks' } = Astro.props;
---

{exhibits.length > 0 && (
  <aside class="related-panel backlinks-panel">
    <p class="related-panel-label">{title}</p>
    <ul class="related-list">
      {exhibits.map((exhibit) => (
        <li>
          <a href={`/exhibit/${exhibit.slug}`} class="related-link">
            <span class="related-link-title">{displayTitle(exhibit)}</span>
            <span class="related-link-meta">{typeLabel(exhibit)}</span>
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}
