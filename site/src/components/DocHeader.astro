---
import Icon from './Icon.astro';
import { iconForType } from '../lib/icons';

interface Props {
  type: string;
  typeLabel: string;
  essence?: string;
  summary: string;
  hub?: {
    slug: string;
    title: string;
    href: string;
  };
  difficulty?: string;
}

const { type, typeLabel, essence, summary, hub, difficulty } = Astro.props;
const lead = essence ?? summary;
---

<header class="doc-header">
  <p class="doc-eyebrow">
    <Icon name={iconForType(type)} size={16} />
    <span>{typeLabel}</span>
    {hub && (
      <>
        <span>·</span>
        <a href={hub.href}>{hub.title}</a>
      </>
    )}
  </p>
  <h1 class="doc-title"><slot /></h1>
  <p class="doc-lead">{lead}</p>
  {(difficulty) && (
    <div class="doc-meta">
      <span class="doc-meta-item">{difficulty}</span>
    </div>
  )}
</header>
