---
import type { DocSection } from '../lib/content';

interface Props {
  sections: DocSection[];
}

const { sections } = Astro.props;
---

<div class="doc-sections">
  {sections.map((section) => (
    <section
      id={section.id}
      class:list={['doc-section', { 'doc-section--sub': section.level === 3 }]}
    >
      <h2 class="doc-section-title">{section.title}</h2>
      <div class="doc-section-body" set:html={section.html} />
    </section>
  ))}
</div>
