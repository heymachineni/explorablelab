---
import '../styles/design-system.css';
import Icon from '../components/Icon.astro';
import CommandPalette from '../components/CommandPalette.astro';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
  full?: boolean;
  doc?: boolean;
  breadcrumbs?: { label: string; href?: string }[];
}

const {
  title = 'ExplorableLab',
  description = 'Clear explanations of ideas worth understanding.',
  wide = false,
  full = false,
  doc = false,
  breadcrumbs = [],
} = Astro.props;

const path = Astro.url.pathname;
const pathContext = Astro.url.searchParams.get('path');

const nav = [
  { href: '/', label: 'Home', icon: 'home' as const, match: (p: string) => p === '/' },
  {
    href: '/browse',
    label: 'Browse',
    icon: 'browse' as const,
    match: (p: string) =>
      p.startsWith('/browse') ||
      p.startsWith('/graph') ||
      p.startsWith('/view/') ||
      (p.startsWith('/exhibit') && !pathContext),
  },
  {
    href: '/learn',
    label: 'Paths',
    icon: 'paths' as const,
    match: (p: string) =>
      p.startsWith('/learn') ||
      p.startsWith('/collection') ||
      (p.startsWith('/exhibit') && !!pathContext),
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <title>{title === 'ExplorableLab' ? title : `${title} · ExplorableLab`}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="app">
      <aside class="sidebar" aria-label="Main">
        <a href="/" class="sidebar-brand">
          <Icon name="explorable" size={22} />
          ExplorableLab
        </a>

        <nav class="sidebar-nav">
          {nav.map((item) => (
            <a href={item.href} class:list={['sidebar-link', { active: item.match(path) }]}>
              <Icon name={item.icon} size={20} />
              {item.label}
            </a>
          ))}
        </nav>

        <div class="sidebar-footer">
          <a href="/contribute" class:list={['sidebar-link', { active: path.startsWith('/contribute') }]}>
            <Icon name="contribute" size={20} />
            Contribute
          </a>
          <button type="button" class="sidebar-search-btn" id="sidebar-search-btn" aria-label="Search">
            <Icon name="search" size={18} />
            Search
            <kbd>⌘K</kbd>
          </button>
        </div>
      </aside>

      <div class="main">
        <header class="topbar">
          {breadcrumbs.length > 0 ? (
            <nav class="breadcrumbs" aria-label="Breadcrumb">
              {breadcrumbs.map((crumb, i) => (
                <span class="crumb-group">
                  {i > 0 && <span class="breadcrumbs-sep">/</span>}
                  {crumb.href ? (
                    <a href={crumb.href}>{crumb.label}</a>
                  ) : (
                    <span class="breadcrumbs-current">{crumb.label}</span>
                  )}
                </span>
              ))}
            </nav>
          ) : (
            <span class="topbar-title">{title === 'ExplorableLab' ? 'ExplorableLab' : title}</span>
          )}
          <button type="button" class="topbar-search" id="topbar-search-btn" aria-label="Search">
            <Icon name="search" size={18} />
            <kbd>⌘K</kbd>
          </button>
        </header>

        <div class:list={['content', { 'content--wide': wide, 'content--full': full, 'content--doc': doc }]}>
          <slot />
        </div>
      </div>
    </div>

    <nav class="mobile-nav" aria-label="Mobile">
      <a href="/" class:list={[{ active: path === '/' }]}>
        <Icon name="home" size={20} />
        Home
      </a>
      <a href="/browse" class:list={[{ active: path.startsWith('/browse') || path.startsWith('/graph') || path.startsWith('/view/') }]}>
        <Icon name="browse" size={20} />
        Browse
      </a>
      <a href="/learn" class:list={[{ active: path.startsWith('/learn') || path.startsWith('/collection') }]}>
        <Icon name="paths" size={20} />
        Paths
      </a>
    </nav>

    <CommandPalette />
    <script is:inline src="/js/continue-reading.js" defer></script>
    <script is:inline>
      document.getElementById('sidebar-search-btn')?.addEventListener('click', () => {
        document.dispatchEvent(new CustomEvent('open-palette'));
      });
      document.getElementById('topbar-search-btn')?.addEventListener('click', () => {
        document.dispatchEvent(new CustomEvent('open-palette'));
      });
    </script>
  </body>
</html>
