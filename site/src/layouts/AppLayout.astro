---
import '../styles/design-system.css';
import CommandPalette from '../components/CommandPalette.astro';
import { stats } from '../lib/museum';
import { hubs, pinnedHubs } from '../lib/workspace';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
  full?: boolean;
  doc?: boolean;
  breadcrumbs?: { label: string; href?: string }[];
}

const {
  title = 'ExplorableLab',
  description = 'Read-only explanations of theories, patterns, research, and methods.',
  wide = false,
  full = false,
  doc = false,
  breadcrumbs = [],
} = Astro.props;

const path = Astro.url.pathname;
const pathContext = Astro.url.searchParams.get('path');

const primaryNav = [
  { href: '/', label: 'Home', icon: '⌂', match: (p: string) => p === '/' },
  {
    href: '/graph',
    label: 'All pages',
    icon: '▦',
    count: stats.total,
    match: (p: string) =>
      p.startsWith('/graph') || (p.startsWith('/exhibit') && !pathContext && !p.startsWith('/exhibit/')),
  },
  {
    href: '/view/theories',
    label: 'Theories',
    icon: '∑',
    count: stats.theories,
    match: (p: string) => p.startsWith('/view/theories'),
  },
  {
    href: '/view/patterns',
    label: 'Patterns',
    icon: '◇',
    count: stats.patterns,
    match: (p: string) => p.startsWith('/view/patterns'),
  },
  {
    href: '/learn',
    label: 'Paths',
    icon: '→',
    count: stats.paths,
    match: (p: string) =>
      p.startsWith('/learn') ||
      p.startsWith('/collection') ||
      (p.startsWith('/exhibit') && !!pathContext),
  },
];

const sidebarHubs = pinnedHubs.length > 0 ? pinnedHubs : hubs.slice(0, 6);
const hubActive = (slug: string) => path === `/exhibit/${slug}`;
const hubsSectionOpen = path.startsWith('/view/hubs') || hubs.some((h) => hubActive(h.slug));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title === 'ExplorableLab' ? title : `${title} · ExplorableLab`}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="app">
      <aside class="sidebar" aria-label="Sidebar">
        <a href="/" class="sidebar-brand">
          <span class="sidebar-brand-icon" aria-hidden="true">◉</span>
          ExplorableLab
        </a>

        <nav class="sidebar-nav">
          <p class="sidebar-section-label">Workspace</p>
          {primaryNav.map((item) => (
            <a href={item.href} class:list={['sidebar-link', { active: item.match(path) }]}>
              <span class="sidebar-link-left">
                <span class="sidebar-link-icon" aria-hidden="true">{item.icon}</span>
                {item.label}
              </span>
              {item.count !== undefined && <span class="sidebar-count">{item.count}</span>}
            </a>
          ))}

          <details class="sidebar-details" open={hubsSectionOpen}>
            <summary class="sidebar-section-toggle">
              <span>Topic hubs</span>
              <span class="sidebar-count">{stats.topicHubs}</span>
            </summary>
            <div class="sidebar-nested">
              <a href="/view/hubs" class:list={['sidebar-link sidebar-link--nested', { active: path === '/view/hubs' }]}>
                Browse all hubs
              </a>
              {sidebarHubs.map((hub) => (
                <a
                  href={hub.href}
                  class:list={['sidebar-link sidebar-link--nested', { active: hubActive(hub.slug) }]}
                >
                  <span class="sidebar-link-left">{hub.title}</span>
                  <span class="sidebar-count">{hub.memberCount}</span>
                </a>
              ))}
            </div>
          </details>
        </nav>

        <div class="sidebar-footer">
          <a href="/contribute" class:list={['sidebar-link', { active: path.startsWith('/contribute') || path.startsWith('/studio') }]}>
            <span class="sidebar-link-left">
              <span class="sidebar-link-icon" aria-hidden="true">+</span>
              Contribute
            </span>
          </a>
          <p class="sidebar-hint">
            <button type="button" class="sidebar-search-btn" id="sidebar-search-btn" aria-label="Search pages">
              <kbd>⌘</kbd><kbd>K</kbd> search
            </button>
          </p>
        </div>
      </aside>

      <div class="main">
        <header class="topbar">
          {breadcrumbs.length > 0 ? (
            <nav class="breadcrumbs" aria-label="Breadcrumb">
              {breadcrumbs.map((crumb, i) => (
                <span class="crumb-group">
                  {i > 0 && <span class="breadcrumbs-sep">/</span>}
                  {crumb.href ? (
                    <a href={crumb.href}>{crumb.label}</a>
                  ) : (
                    <span class="breadcrumbs-current">{crumb.label}</span>
                  )}
                </span>
              ))}
            </nav>
          ) : (
            <span class="topbar-title">{title === 'ExplorableLab' ? 'ExplorableLab' : title}</span>
          )}
          <button type="button" class="topbar-search" id="topbar-search-btn" aria-label="Search pages">
            Search <kbd>⌘K</kbd>
          </button>
        </header>

        <div class:list={['content', { 'content--wide': wide, 'content--full': full, 'content--doc': doc }]}>
          <slot />
        </div>
      </div>
    </div>

    <nav class="mobile-nav" aria-label="Mobile">
      <a href="/" class:list={[{ active: path === '/' }]}>Home</a>
      <a href="/graph" class:list={[{ active: path.startsWith('/graph') }]}>Pages</a>
      <a href="/view/hubs" class:list={[{ active: path.startsWith('/view/hubs') || path.includes('DIS') }]}>Hubs</a>
      <a href="/learn" class:list={[{ active: path.startsWith('/learn') || path.startsWith('/collection') }]}>Paths</a>
    </nav>

    <CommandPalette />
    <script src="/js/continue-reading.js" defer></script>
    <script is:inline>
      document.getElementById('sidebar-search-btn')?.addEventListener('click', () => {
        document.dispatchEvent(new CustomEvent('open-palette'));
      });
      document.getElementById('topbar-search-btn')?.addEventListener('click', () => {
        document.dispatchEvent(new CustomEvent('open-palette'));
      });
    </script>
  </body>
</html>
