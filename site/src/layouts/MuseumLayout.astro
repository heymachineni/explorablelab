---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}

const { title = 'ExplorableLab', description = 'Explore ideas that only make sense when you play with them.', wide = false } = Astro.props;

const navItems = [
  { href: '/play', label: 'Play' },
  { href: '/discover', label: 'Discover' },
  { href: '/learn', label: 'Learn' },
  { href: '/graph', label: 'Graph' },
  { href: '/studio/echo', label: 'Studio' },
  { href: '/contribute', label: 'Contribute' },
];

const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title === 'ExplorableLab' ? title : `${title} · ExplorableLab`}</title>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="logo">ExplorableLab</a>
      <nav class="site-nav" aria-label="Main">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={['nav-link', { active: path === item.href || (item.href !== '/' && path.startsWith(item.href)) }]}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </header>

    <main class:list={['site-main', { 'site-main--wide': wide }]}>
      <slot />
    </main>

    <footer class="site-footer">
      <p class="footer-copy">Explore ideas that only make sense when you play with them.</p>
      <nav class="footer-nav" aria-label="Footer">
        <a href="/contribute">Contribute</a>
        <a href="https://github.com/heymachineni/explorablelab" rel="noopener noreferrer">GitHub</a>
      </nav>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem clamp(1rem, 4vw, 1.5rem);
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .logo {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
    flex-shrink: 0;
  }

  .logo:hover {
    color: var(--text);
    opacity: 0.7;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.125rem 0.25rem;
  }

  .nav-link {
    color: var(--text-muted);
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 0.35rem 0.5rem;
    border-radius: var(--radius);
  }

  .nav-link:hover {
    background: var(--bg-hover);
    color: var(--text);
  }

  .nav-link.active {
    color: var(--text);
    background: var(--bg-hover);
  }

  .site-main {
    flex: 1;
    width: 100%;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: clamp(1.25rem, 4vw, 2rem) clamp(1rem, 4vw, 1.5rem);
  }

  .site-main--wide {
    max-width: var(--page-wide);
  }

  .site-footer {
    margin-top: auto;
    padding: 1.25rem clamp(1rem, 4vw, 1.5rem);
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .footer-copy {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-faint);
  }

  .footer-nav {
    display: flex;
    gap: 1rem;
    font-size: 0.8125rem;
  }

  .footer-nav a {
    color: var(--text-muted);
  }

  @media (max-width: 520px) {
    .site-header {
      flex-direction: column;
      align-items: stretch;
    }

    .site-nav {
      justify-content: flex-start;
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 0.125rem;
      -webkit-overflow-scrolling: touch;
    }

    .nav-link {
      flex-shrink: 0;
    }
  }
</style>
