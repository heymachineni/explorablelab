---
interface Props {
  title?: string;
  description?: string;
}

const { title = 'ExplorableLab', description = 'Explore ideas that only make sense when you play with them.' } = Astro.props;

const navItems = [
  { href: '/play', label: 'Play' },
  { href: '/discover', label: 'Discover' },
  { href: '/learn', label: 'Learn' },
  { href: '/graph', label: 'Graph' },
  { href: '/studio/echo', label: 'Studio' },
  { href: '/contribute', label: 'Contribute' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title === 'ExplorableLab' ? title : `${title} · ExplorableLab`}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,600;0,700;1,400&family=Source+Sans+3:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="logo">
        <span class="logo-mark">◈</span>
        ExplorableLab
      </a>
      <nav class="site-nav" aria-label="Main">
        {navItems.map((item) => (
          <a href={item.href} class:list={['nav-link', { active: Astro.url.pathname.startsWith(item.href) }]}>
            {item.label}
          </a>
        ))}
      </nav>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <p class="footer-tagline">Explore ideas that only make sense when you play with them.</p>
      <nav class="footer-nav" aria-label="Footer">
        <a href="/contribute">Contribute</a>
        <a href="https://github.com/heymachineni/explorablelab" rel="noopener noreferrer">Workshop</a>
        <span class="footer-note">CC0 · Inspired by Bret Victor, Nicky Case, Distill, the Exploratorium</span>
      </nav>
    </footer>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  :root {
    --bg: #1a1410;
    --bg-elevated: #241c17;
    --bg-card: #2a211c;
    --text: #f5ebe0;
    --text-muted: #c4b5a5;
    --accent: #e07a5f;
    --accent-soft: rgba(224, 122, 95, 0.15);
    --border: rgba(245, 235, 224, 0.12);
    --serif: 'Crimson Pro', Georgia, 'Times New Roman', serif;
    --sans: 'Source Sans 3', system-ui, -apple-system, sans-serif;
    --radius: 6px;
    --shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    font-size: 1.05rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3,
  h4 {
    font-family: var(--serif);
    font-weight: 600;
    line-height: 1.25;
    margin: 0 0 0.5em;
  }

  a {
    color: var(--accent);
    text-decoration: none;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  a:hover {
    color: #f0a090;
  }

  img {
    max-width: 100%;
    height: auto;
  }
</style>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.25rem 2rem;
    border-bottom: 1px solid var(--border);
    background: rgba(26, 20, 16, 0.92);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--serif);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.02em;
  }

  .logo:hover {
    color: var(--accent);
  }

  .logo-mark {
    color: var(--accent);
    font-size: 1.1rem;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }

  .nav-link {
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.25rem 0;
    border-bottom: 2px solid transparent;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--text);
    border-bottom-color: var(--accent);
  }

  .site-main {
    flex: 1;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .site-footer {
    margin-top: auto;
    padding: 2.5rem 2rem;
    border-top: 1px solid var(--border);
    text-align: center;
  }

  .footer-tagline {
    font-family: var(--serif);
    font-style: italic;
    color: var(--text-muted);
    margin: 0 0 1rem;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem 1.5rem;
    font-size: 0.9rem;
  }

  .footer-nav a {
    color: var(--text-muted);
  }

  .footer-nav a:hover {
    color: var(--accent);
  }

  .footer-note {
    color: rgba(196, 181, 165, 0.6);
    font-size: 0.85rem;
  }

  @media (max-width: 640px) {
    .site-header {
      flex-direction: column;
      align-items: flex-start;
      padding: 1rem 1.25rem;
    }

    .site-main {
      padding: 1.25rem;
    }
  }
</style>
