---
import AppLayout from '../layouts/AppLayout.astro';
import { displayTitle, playableExhibits } from '../lib/museum';

const playable = playableExhibits();
const native = playable.filter((e) => e.playUrl);
const canon = playable.filter((e) => e.embedUrl);
---

<AppLayout
  title="Play"
  description="All exhibits playable today."
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Play' }]}
  wide
>
  <h1 class="page-title">Play</h1>
  <p class="page-lead">
    {playable.length} exhibits ready to run — {native.length} built here, {canon.length} canon embeds.
    Everything on this page works today.
  </p>

  {native.length > 0 && (
    <section class="section">
      <p class="section-label">Built at ExplorableLab</p>
      <div class="db-table">
        {native.map((exhibit) => (
          <a href={`/exhibit/${exhibit.slug}`} class="db-row">
            <div>
              <p class="db-row-title">{displayTitle(exhibit)}</p>
              <p class="db-row-meta">{exhibit.summary}</p>
            </div>
            <div class="db-row-right">
              <span class="pill pill--ready">Native</span>
              <span class="db-row-action">Play</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="section">
    <p class="section-label">Canon explorables</p>
    <div class="db-table">
      {canon.map((exhibit) => (
        <a href={`/exhibit/${exhibit.slug}`} class="db-row">
          <div>
            <p class="db-row-title">{displayTitle(exhibit)}</p>
            <p class="db-row-meta">{exhibit.summary}</p>
          </div>
          <div class="db-row-right">
            <span class="pill pill--meta">Embed</span>
            <span class="db-row-action">Play</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</AppLayout>
