---
import MuseumLayout from '../layouts/MuseumLayout.astro';

const nativeSims = [
  { slug: 'petrie-multiplier', title: 'Petrie Multiplier', hook: 'Equal meanness. Unequal harm.', url: '/sims/petrie-multiplier/' },
  { slug: 'ergodicity-street', title: 'Ergodicity Street', hook: "The average person doesn't exist.", url: '/sims/ergodicity-street/' },
];

const canonGames = [
  { slug: 'evolution-of-trust', title: 'Evolution of Trust', hook: 'Cooperation in repeated games.' },
  { slug: 'we-become-what-we-behold', title: 'We Become What We Behold', hook: 'News cycles and small acts of bigotry.' },
  { slug: 'to-build-a-better-ballot', title: 'To Build a Better Ballot', hook: 'Same voters, different winners.' },
  { slug: 'loopy', title: 'Loopy', hook: 'Draw feedback loops.' },
  { slug: 'fireflies', title: 'Fireflies', hook: 'Synchronization from local rules.' },
  { slug: 'wisdom-and-madness-of-crowds', title: 'Wisdom and/or Madness of Crowds', hook: 'When groups think well — and badly.' },
  { slug: 'parable-of-polygons', title: 'Parable of the Polygons', hook: 'Segregation without villains.' },
  { slug: 'adventures-with-anxiety', title: 'Adventures with Anxiety', hook: 'A playable story about anxiety.' },
  { slug: 'how-to-remember-anything-forever-ish', title: 'How to Remember Anything Forever-ish', hook: 'Spaced repetition, explained.' },
];

const paradoxes = [
  { slug: 'monty-hall', title: 'Monty Hall Problem' },
  { slug: 'simpsons-paradox', title: "Simpson's Paradox" },
  { slug: 'st-petersburg-paradox', title: 'St. Petersburg Paradox' },
  { slug: 'prisoners-dilemma', title: "Prisoner's Dilemma" },
  { slug: 'petrie-multiplier', title: 'Petrie Multiplier' },
];
---

<MuseumLayout title="Play" description="Native simulations and playable exhibits." wide>
  <header class="page-header">
    <h1>Play</h1>
    <p class="lead">Simulations you can run now — native builds and linked canon explorables.</p>
  </header>

  <section class="section">
    <h2 class="section-heading">Built at ExplorableLab</h2>
    {nativeSims.map((sim) => (
      <article class="sim-block">
        <div class="sim-head">
          <div>
            <h3 class="sim-title"><a href={`/exhibit/${sim.slug}`}>{sim.title}</a></h3>
            <p class="sim-hook">{sim.hook}</p>
          </div>
          <a href={sim.url} class="btn btn-primary">Full screen</a>
        </div>
        <div class="embed">
          <iframe src={sim.url} title={sim.title} loading="lazy"></iframe>
        </div>
      </article>
    ))}
  </section>

  <section class="section">
    <h2 class="section-heading">Canon explorables</h2>
    <p class="section-note">Classic interactives — open each exhibit to play embedded.</p>
    <div class="row-list">
      {canonGames.map((game) => (
        <a href={`/exhibit/${game.slug}`} class="row-link">
          <div>
            <p class="row-link__title">{game.title}</p>
            <p class="row-link__meta">{game.hook}</p>
          </div>
          <span class="row-link__action">Open →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <h2 class="section-heading">Paradox gallery</h2>
    <div class="grid-auto">
      {paradoxes.map((p) => (
        <a href={`/exhibit/${p.slug}`} class="card card-interactive">
          <p class="card-title">{p.title}</p>
        </a>
      ))}
    </div>
  </section>
</MuseumLayout>

<style>
  .sim-block {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .sim-block:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }

  .sim-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .sim-title {
    font-size: 1rem;
    margin: 0 0 0.15rem;
  }

  .sim-title a {
    color: var(--text);
  }

  .sim-title a:hover {
    color: var(--accent);
  }

  .sim-hook {
    margin: 0;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .section-note {
    margin: 0 0 0.75rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .card-title {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 500;
  }
</style>
