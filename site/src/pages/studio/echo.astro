---
import MuseumLayout from '../../layouts/MuseumLayout.astro';
---

<MuseumLayout title="E.C.H.O. Studio" description="Design worksheet — Hook, Engine, Control, Outcome gap.">
  <header class="page-header">
    <h1>E.C.H.O. Studio</h1>
    <p class="lead">Hook · Engine · Control · Outcome gap — fill before you build.</p>
  </header>

  <form class="echo-form" id="echo-form">
    <label class="field">
      <span>Hook</span>
      <textarea name="hook" rows="2" placeholder="One sentence that creates stakes"></textarea>
    </label>
    <label class="field">
      <span>Engine</span>
      <textarea name="engine" rows="3" placeholder="What system runs?"></textarea>
    </label>
    <label class="field">
      <span>Control</span>
      <textarea name="control" rows="2" placeholder="What does the user adjust?"></textarea>
    </label>
    <label class="field">
      <span>Outcome gap</span>
      <textarea name="outcome" rows="3" placeholder="Predict vs reveal"></textarea>
    </label>
    <button type="button" class="btn btn-primary" id="save-echo">Save draft</button>
  </form>

  <section class="section example">
    <h2 class="section-heading">Exemplar: Petrie Multiplier</h2>
    <table class="table">
      <thead><tr><th>Element</th><th>Spec</th></tr></thead>
      <tbody>
        <tr><td>Hook</td><td>Equal meanness. Unequal harm.</td></tr>
        <tr><td>Engine</td><td>Pairwise harassment lottery</td></tr>
        <tr><td>Control</td><td>Minority %, rate, N</td></tr>
        <tr><td>Outcome gap</td><td>Fair rates → unfair totals</td></tr>
      </tbody>
    </table>
    <p><a href="/exhibit/petrie-multiplier">Open exhibit →</a></p>
  </section>

  <script is:inline>
    const form = document.getElementById('echo-form');
    const key = 'explorablelab-echo-draft';
    const saved = localStorage.getItem(key);
    if (saved && form) {
      try {
        const data = JSON.parse(saved);
        for (const [k, v] of Object.entries(data)) {
          const el = form.elements.namedItem(k);
          if (el && 'value' in el) el.value = v;
        }
      } catch (_) {}
    }
    document.getElementById('save-echo')?.addEventListener('click', () => {
      if (!form) return;
      localStorage.setItem(key, JSON.stringify(Object.fromEntries(new FormData(form))));
    });
  </script>
</MuseumLayout>

<style>
  .echo-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  textarea {
    font-family: var(--font);
    font-size: 0.9375rem;
    padding: 0.5rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text);
    resize: vertical;
    line-height: 1.5;
  }

  textarea:focus {
    outline: none;
    border-color: var(--border-strong);
  }

  .table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    margin-bottom: 0.75rem;
  }

  .table th,
  .table td {
    text-align: left;
    padding: 0.5rem 0.625rem;
    border-bottom: 1px solid var(--border);
  }

  .table th {
    color: var(--text-muted);
    font-weight: 500;
  }
</style>
