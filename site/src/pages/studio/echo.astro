---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout
  title="E.C.H.O. Studio"
  description="Design worksheet for explorable simulations."
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Contribute', href: '/contribute' },
    { label: 'E.C.H.O.' },
  ]}
>
  <h1 class="page-title">E.C.H.O. Studio</h1>
  <p class="page-lead">Hook · Engine · Control · Outcome gap — define the simulation before you build it.</p>

  <form class="echo-form" id="echo-form">
    <label class="field">
      <span>Hook — one sentence that creates stakes</span>
      <textarea name="hook" rows="2" placeholder="Equal meanness. Unequal harm."></textarea>
    </label>
    <label class="field">
      <span>Engine — what system runs</span>
      <textarea name="engine" rows="3" placeholder="Pairwise interactions at equal rates…"></textarea>
    </label>
    <label class="field">
      <span>Control — what the user adjusts</span>
      <textarea name="control" rows="2" placeholder="Minority share, rate, population size"></textarea>
    </label>
    <label class="field">
      <span>Outcome gap — predict vs reveal</span>
      <textarea name="outcome" rows="3" placeholder="They predict fairness. They see 3× harm on minority."></textarea>
    </label>
    <button type="button" class="btn btn-primary" id="save-echo">Save draft locally</button>
  </form>

  <section class="section">
    <p class="section-label">Exemplar</p>
    <div class="db-table">
      <a href="/exhibit/petrie-multiplier" class="db-row">
        <div>
          <p class="db-row-title">Petrie Multiplier</p>
          <p class="db-row-meta">Native sim · predict-then-reveal · combinatorics</p>
        </div>
        <span class="pill pill--ready">Play</span>
      </a>
    </div>
  </section>
</AppLayout>

<script is:inline>
  const form = document.getElementById('echo-form');
  const key = 'explorablelab-echo-draft';
  try {
    const saved = JSON.parse(localStorage.getItem(key) || '{}');
    for (const [k, v] of Object.entries(saved)) {
      const el = form?.elements.namedItem(k);
      if (el && 'value' in el) el.value = v;
    }
  } catch (_) {}
  document.getElementById('save-echo')?.addEventListener('click', () => {
    if (!form) return;
    localStorage.setItem(key, JSON.stringify(Object.fromEntries(new FormData(form))));
    const btn = document.getElementById('save-echo');
    if (btn) btn.textContent = 'Saved';
    setTimeout(() => { if (btn) btn.textContent = 'Save draft locally'; }, 1500);
  });
</script>

<style>
  .echo-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  textarea {
    font-family: var(--font);
    font-size: 0.9375rem;
    padding: 0.5rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text);
    resize: vertical;
    line-height: 1.5;
  }

  textarea:focus {
    outline: none;
    border-color: var(--accent);
  }
</style>
