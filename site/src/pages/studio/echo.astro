---
import AppLayout from '../../layouts/AppLayout.astro';
import Icon from '../../components/Icon.astro';
---

<AppLayout
  title="E.C.H.O. Studio"
  description="Design worksheet for explorable simulations."
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Contribute', href: '/contribute' },
    { label: 'E.C.H.O.' },
  ]}
>
  <header class="browse-header">
    <h1 class="browse-title">E.C.H.O. Studio</h1>
    <p class="browse-lead">Hook · Engine · Control · Outcome — define the idea before you build.</p>
  </header>

  <form class="form-stack" id="echo-form">
    <label class="field">
      <span class="field-label">Hook</span>
      <textarea name="hook" rows="2" placeholder="One sentence that creates stakes"></textarea>
    </label>
    <label class="field">
      <span class="field-label">Engine</span>
      <textarea name="engine" rows="3" placeholder="What system runs"></textarea>
    </label>
    <label class="field">
      <span class="field-label">Control</span>
      <textarea name="control" rows="2" placeholder="What the reader can adjust"></textarea>
    </label>
    <label class="field">
      <span class="field-label">Outcome gap</span>
      <textarea name="outcome" rows="3" placeholder="What they predict vs what they learn"></textarea>
    </label>
    <button type="button" class="btn btn-primary" id="save-echo">Save draft</button>
  </form>

  <section class="section-block">
    <h2 class="home-section-title">Exemplar</h2>
    <ul class="page-rows">
      <li class="page-row">
        <a href="/exhibit/petrie-multiplier" class="page-row-link">
          <span class="page-row-icon">
            <Icon name="simulation" size={18} />
          </span>
          <span class="page-row-body">
            <span class="page-row-title">Petrie Multiplier</span>
            <span class="page-row-summary">Predict-then-reveal · combinatorics · harm amplification</span>
          </span>
          <Icon name="chevron-right" size={18} class="page-row-chevron" />
        </a>
      </li>
    </ul>
  </section>
</AppLayout>

<script is:inline>
  const form = document.getElementById('echo-form');
  const key = 'explorablelab-echo-draft';
  try {
    const saved = JSON.parse(localStorage.getItem(key) || '{}');
    for (const [k, v] of Object.entries(saved)) {
      const el = form?.elements.namedItem(k);
      if (el && 'value' in el) el.value = v;
    }
  } catch (_) {}
  document.getElementById('save-echo')?.addEventListener('click', () => {
    if (!form) return;
    localStorage.setItem(key, JSON.stringify(Object.fromEntries(new FormData(form))));
    const btn = document.getElementById('save-echo');
    if (btn) btn.textContent = 'Saved';
    setTimeout(() => { if (btn) btn.textContent = 'Save draft'; }, 1500);
  });
</script>
