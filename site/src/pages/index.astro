---
import MuseumLayout from '../layouts/MuseumLayout.astro';
import canonicalData from '../data/canonical.json';
import collectionsData from '../data/collections.json';
import type { Exhibit } from '../types';

const exhibits = canonicalData.exhibits as Exhibit[];
const collections = collectionsData.collections;

const nativeSims = exhibits.filter((e) => e.playUrl);
const startCollection = collections.find((c) => c.slug === 'start-here-first-visit');
---

<MuseumLayout title="ExplorableLab">
  <section class="hero">
    <p class="hero-eyebrow">Interactive museum</p>
    <h1>Explore ideas that only make sense when you play with them.</h1>
    <p class="hero-desc">
      Curated simulations, paradoxes, and paths — built to be touched, not read.
    </p>
    <div class="btn-row hero-actions">
      <a href="/learn" class="btn btn-primary">Start here</a>
      <a href="/discover" class="btn">Surprise me</a>
      <a href="/play" class="btn">Play</a>
    </div>
  </section>

  {nativeSims.length > 0 && (
    <section class="section">
      <div class="section-header">
        <h2>Built here</h2>
        <span class="meta">Native simulations</span>
      </div>
      <div class="row-list">
        {nativeSims.map((sim) => (
          <a href={sim.playUrl} class="row-link">
            <div>
              <p class="row-link__title">{sim.title}</p>
              <p class="row-link__meta">{sim.hook ?? sim.summary}</p>
            </div>
            <span class="row-link__action">Play →</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {startCollection && (
    <section class="section">
      <div class="section-header">
        <h2>First visit</h2>
        <a href={`/collection/${startCollection.slug}`} class="link-muted">Full path →</a>
      </div>
      <p class="section-note">{startCollection.time_minutes} min · {startCollection.stops.length} stops</p>
      <div class="row-list">
        {startCollection.stops.slice(0, 5).map((slug) => {
          const ex = exhibits.find((e) => e.slug === slug);
          return (
            <a href={`/exhibit/${slug}`} class="row-link">
              <div>
                <p class="row-link__title">{ex?.title ?? slug}</p>
                <p class="row-link__meta">{ex?.hook ?? ex?.summary ?? 'Exhibit'}</p>
              </div>
              <span class="row-link__action">Open</span>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <section class="section">
    <div class="section-header">
      <h2>Collections</h2>
      <a href="/learn" class="link-muted">All collections →</a>
    </div>
    <div class="grid-auto">
      {collections.slice(0, 6).map((col) => (
        <a href={`/collection/${col.slug}`} class="card card-interactive">
          <p class="card-title">{col.title}</p>
          <p class="card-meta">{col.time_minutes > 0 ? `${col.time_minutes} min` : 'Reference'} · {col.stops.length} stops</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>Constellation</h2>
      <a href="/graph" class="link-muted">Open graph →</a>
    </div>
    <p class="section-note">Browse {exhibits.length} canonical exhibits and how they connect.</p>
    <a href="/graph" class="btn">View constellation</a>
  </section>
</MuseumLayout>

<style>
  .hero {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .hero-eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-faint);
  }

  .hero h1 {
    font-size: clamp(1.75rem, 5vw, 2.25rem);
    max-width: 18ch;
    margin-bottom: 0.75rem;
  }

  .hero-desc {
    margin: 0 0 1.25rem;
    color: var(--text-muted);
    max-width: 42ch;
    font-size: 1rem;
    line-height: 1.6;
  }

  .hero-actions {
    margin-top: 0.5rem;
  }

  .section-note {
    margin: 0 0 0.75rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .row-list {
    margin: 0;
  }

  .card-title {
    margin: 0 0 0.25rem;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .card-meta {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
</style>
