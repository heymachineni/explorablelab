---
import AppLayout from '../layouts/AppLayout.astro';
import ContinueReading from '../components/ContinueReading.astro';
import Icon from '../components/Icon.astro';
import { collectionBySlug } from '../lib/museum';
import { pinnedHubs } from '../lib/workspace';

const startPath = collectionBySlug('start-here-first-visit');
---

<AppLayout title="ExplorableLab">
  <div class="home">
    <header class="home-hero">
      <h1 class="home-title">Understand how the world works.</h1>
      <p class="home-subtitle">
        Clear explanations of theories, patterns, and ideas — written to read, not to play.
      </p>
      <div class="home-actions">
        {startPath && (
          <a href={`/collection/${startPath.slug}`} class="btn btn-primary">Start reading</a>
        )}
        <a href="/browse" class="btn">Browse all</a>
      </div>
    </header>

    <ContinueReading />

    {startPath && (
      <section class="home-section">
        <h2 class="home-section-title">Suggested path</h2>
        <ul class="path-rows">
          <li class="path-row">
            <a href={`/collection/${startPath.slug}`} class="path-link">
              <Icon name="paths" size={20} />
              <span class="path-body">
                <span class="path-title">{startPath.title}</span>
                <span class="path-meta">{startPath.time_minutes} min · {startPath.stops.length} readings</span>
              </span>
              <Icon name="chevron-right" size={18} />
            </a>
          </li>
        </ul>
      </section>
    )}

    <section class="home-section">
      <h2 class="home-section-title">Start with a topic</h2>
      <ul class="topic-rows">
        {pinnedHubs.map((hub) => (
          <li class="topic-row">
            <a href={hub.href} class="topic-link">
              <Icon name="hub" size={20} />
              <span class="topic-body">
                <span class="topic-title">{hub.title}</span>
                <span class="topic-meta">{hub.summary}</span>
              </span>
              <Icon name="chevron-right" size={18} />
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</AppLayout>
