---
import AppLayout from '../layouts/AppLayout.astro';
import {
  collectionBySlug,
  displayTitle,
  exhibitsByType,
  stats,
  typeLabel,
} from '../lib/museum';

const startPath = collectionBySlug('start-here-first-visit');
const theories = exhibitsByType('THY');
const patterns = exhibitsByType('PAT');
---

<AppLayout title="ExplorableLab">
  <section class="hero-block">
    <p class="section-label">Research museum</p>
    <h1 class="page-title">Theories, patterns, and methods — explained.</h1>
    <p class="page-lead">
      Read-only explanations from our corpus. No external embeds, no unfinished sims —
      just what we know about each idea, how it connects, and why it matters.
    </p>

    <div class="stat-row">
      <div class="stat-item">
        <div class="stat-value">{stats.total}</div>
        <div class="stat-label">Explanations</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">{stats.theories}</div>
        <div class="stat-label">Theories</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">{stats.patterns}</div>
        <div class="stat-label">Patterns</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">{stats.paths}</div>
        <div class="stat-label">Paths</div>
      </div>
    </div>

    <div class="btn-row">
      {startPath && (
        <a href={`/collection/${startPath.slug}`} class="btn btn-primary">Begin first visit</a>
      )}
      <a href="/graph" class="btn">Browse atlas</a>
    </div>
  </section>

  <section class="section">
    <p class="section-label">Browse by type</p>
    <div class="how-grid">
      <div class="how-card">
        <h3>Theories</h3>
        <p>{stats.theories} foundational models — emergence, ergodicity, contagion, and more.</p>
        <a href="/graph?type=THY">Browse theories →</a>
      </div>
      <div class="how-card">
        <h3>Patterns</h3>
        <p>{stats.patterns} interaction and design patterns for explorable explanations.</p>
        <a href="/graph?type=PAT">Browse patterns →</a>
      </div>
      <div class="how-card">
        <h3>Paths</h3>
        <p>{stats.paths} curated reading sequences with time estimates.</p>
        <a href="/learn">Browse paths →</a>
      </div>
    </div>
  </section>

  {startPath && (
    <section class="section">
      <div class="section-header-inline">
        <div>
          <p class="section-label">Recommended</p>
          <h2 class="section-title">{startPath.title}</h2>
          <p class="page-lead" style="margin: 0;">
            {startPath.time_minutes} min · {startPath.stops.length} stops
          </p>
        </div>
        <a href={`/collection/${startPath.slug}`} class="btn">Start path</a>
      </div>
    </section>
  )}

  <section class="section">
    <p class="section-label">Theories</p>
    <div class="db-table">
      {theories.slice(0, 6).map((exhibit) => (
        <a href={`/exhibit/${exhibit.slug}`} class="db-row">
          <div>
            <p class="db-row-title">{displayTitle(exhibit)}</p>
            <p class="db-row-meta">{exhibit.summary}</p>
          </div>
          <span class="db-row-action">Read</span>
        </a>
      ))}
    </div>
    {theories.length > 6 && (
      <p style="margin-top: 0.75rem;">
        <a href="/graph?type=THY">View all {theories.length} theories →</a>
      </p>
    )}
  </section>

  <section class="section">
    <p class="section-label">Patterns</p>
    <div class="db-table">
      {patterns.slice(0, 6).map((exhibit) => (
        <a href={`/exhibit/${exhibit.slug}`} class="db-row">
          <div>
            <p class="db-row-title">{displayTitle(exhibit)}</p>
            <p class="db-row-meta">{typeLabel(exhibit)} · {exhibit.wing}</p>
          </div>
          <span class="db-row-action">Read</span>
        </a>
      ))}
    </div>
    {patterns.length > 6 && (
      <p style="margin-top: 0.75rem;">
        <a href="/graph?type=PAT">View all {patterns.length} patterns →</a>
      </p>
    )}
  </section>
</AppLayout>

<style>
  .hero-block {
    margin-bottom: 2rem;
  }

  .how-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .how-card {
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
  }

  .how-card h3 {
    font-size: 0.9375rem;
    margin-bottom: 0.35rem;
  }

  .how-card p {
    margin: 0 0 0.625rem;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .how-card a {
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .section-header-inline {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-subtle);
  }

  @media (max-width: 720px) {
    .how-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
