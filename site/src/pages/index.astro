---
import AppLayout from '../layouts/AppLayout.astro';
import ContinueReading from '../components/ContinueReading.astro';
import {
  collectionBySlug,
  stats,
} from '../lib/museum';
import { databaseRows, pinnedHubs } from '../lib/workspace';

const startPath = collectionBySlug('start-here-first-visit');
const recentTheoryRows = databaseRows.filter((r) => r.type === 'THY').slice(0, 6);
---

<AppLayout title="ExplorableLab">
  <div class="workspace-home">
    <header class="workspace-hero">
      <p class="workspace-eyebrow">Workspace</p>
      <h1 class="workspace-title">ExplorableLab</h1>
      <p class="workspace-subtitle">
        A read-only knowledge workspace — {stats.total} curated pages of theories, patterns,
        paradoxes, and methods. Follow links, browse databases, or start a path.
      </p>
      <div class="workspace-actions">
        {startPath && (
          <a href={`/collection/${startPath.slug}`} class="btn btn-primary">Start first visit</a>
        )}
        <a href="/graph" class="btn">Open all pages</a>
        <button type="button" class="btn btn-ghost" id="home-search-btn">Search ⌘K</button>
      </div>
    </header>

    <ContinueReading />

    <div class="workspace-metrics">
      <a href="/graph" class="metric-card">
        <span class="metric-value">{stats.total}</span>
        <span class="metric-label">All pages</span>
      </a>
      <a href="/view/theories" class="metric-card">
        <span class="metric-value">{stats.theories}</span>
        <span class="metric-label">Theories</span>
      </a>
      <a href="/view/patterns" class="metric-card">
        <span class="metric-value">{stats.patterns}</span>
        <span class="metric-label">Patterns</span>
      </a>
      <a href="/view/hubs" class="metric-card">
        <span class="metric-value">{stats.topicHubs}</span>
        <span class="metric-label">Topic hubs</span>
      </a>
      <a href="/learn" class="metric-card">
        <span class="metric-value">{stats.paths}</span>
        <span class="metric-label">Paths</span>
      </a>
    </div>

    <section class="workspace-section">
      <div class="workspace-section-head">
        <h2 class="workspace-section-title">Pinned topic hubs</h2>
        <a href="/view/hubs" class="text-link">All hubs →</a>
      </div>
      <div class="hub-grid">
        {pinnedHubs.map((hub) => (
          <a href={hub.href} class="hub-card">
            <span class="hub-card-icon" aria-hidden="true">◉</span>
            <span class="hub-card-title">{hub.title}</span>
            <span class="hub-card-meta">{hub.memberCount} pages · {hub.summary}</span>
          </a>
        ))}
      </div>
    </section>

    {startPath && (
      <section class="workspace-section">
        <div class="workspace-section-head">
          <h2 class="workspace-section-title">Recommended path</h2>
          <a href={`/collection/${startPath.slug}`} class="text-link">Open →</a>
        </div>
        <a href={`/collection/${startPath.slug}`} class="path-card">
          <p class="path-card-title">{startPath.title}</p>
          <p class="path-card-meta">{startPath.time_minutes} min · {startPath.stops.length} stops</p>
          <p class="path-card-summary">{startPath.summary}</p>
        </a>
      </section>
    )}

    <section class="workspace-section">
      <div class="workspace-section-head">
        <h2 class="workspace-section-title">Recently added theories</h2>
        <a href="/view/theories" class="text-link">See all →</a>
      </div>
      <div class="quick-list">
        {recentTheoryRows.map((row) => (
          <a href={row.href} class="quick-list-row">
            <span class="page-icon-sm" aria-hidden="true">∑</span>
            <span>
              <span class="quick-list-title">{row.title}</span>
              <span class="quick-list-meta">{row.summary}</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  </div>
</AppLayout>

<script is:inline>
  document.getElementById('home-search-btn')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('open-palette'));
  });
</script>

<style>
  .workspace-home {
    max-width: var(--content-wide);
  }

  .workspace-hero {
    margin-bottom: 2rem;
  }

  .workspace-eyebrow {
    margin: 0 0 0.35rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .workspace-title {
    font-size: 2.5rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 0.5rem;
  }

  .workspace-subtitle {
    margin: 0 0 1.25rem;
    max-width: 42rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .workspace-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .workspace-metrics {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.5rem;
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .metric-card {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.875rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
    background: var(--bg);
  }

  .metric-card:hover {
    background: var(--bg-hover);
  }

  .metric-value {
    font-size: 1.25rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .metric-label {
    font-size: 0.75rem;
    color: var(--text-tertiary);
  }

  .workspace-section {
    margin-bottom: 2.5rem;
  }

  .workspace-section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .workspace-section-title {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin: 0;
  }

  .hub-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .hub-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.875rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
    background: var(--bg);
  }

  .hub-card:hover {
    background: var(--bg-hover);
  }

  .hub-card-icon {
    font-size: 1rem;
    color: var(--text-tertiary);
  }

  .hub-card-title {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .hub-card-meta {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .path-card {
    display: block;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
  }

  .path-card:hover {
    background: var(--bg-hover);
  }

  .path-card-title {
    margin: 0 0 0.25rem;
    font-weight: 600;
    font-size: 1rem;
  }

  .path-card-meta {
    margin: 0 0 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-tertiary);
  }

  .path-card-summary {
    margin: 0;
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .quick-list {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .quick-list-row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: start;
    padding: 0.75rem 0.875rem;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--text);
  }

  .quick-list-row:last-child {
    border-bottom: none;
  }

  .quick-list-row:hover {
    background: var(--bg-hover);
  }

  .quick-list-title {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .quick-list-meta {
    display: block;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    margin-top: 0.1rem;
    line-height: 1.4;
  }

  @media (max-width: 900px) {
    .workspace-metrics {
      grid-template-columns: repeat(2, 1fr);
    }

    .hub-grid {
      grid-template-columns: 1fr;
    }

    .workspace-title {
      font-size: 2rem;
    }
  }
</style>
