---
import MuseumLayout from '../../layouts/MuseumLayout.astro';
import canonicalData from '../../data/canonical.json';
import type { Exhibit } from '../../types';

export function getStaticPaths() {
  const exhibits = canonicalData.exhibits as Exhibit[];
  return exhibits.map((exhibit) => ({
    params: { slug: exhibit.slug },
    props: { exhibit },
  }));
}

interface Props {
  exhibit: Exhibit;
}

const { exhibit } = Astro.props;
const exhibits = canonicalData.exhibits as Exhibit[];
const relatedExhibits = exhibit.related
  .map((slug) => exhibits.find((e) => e.slug === slug))
  .filter(Boolean) as Exhibit[];
---

<MuseumLayout title={exhibit.title} description={exhibit.summary} wide={!!(exhibit.embedUrl || exhibit.playUrl)}>
  <article>
    <header class="exhibit-header">
      <p class="meta">{exhibit.type} · {exhibit.wing}</p>
      <h1>{exhibit.title}</h1>
      <p class="summary">{exhibit.hook ?? exhibit.summary}</p>
    </header>

    {exhibit.embedUrl && (
      <section class="section">
        <div class="embed">
          <iframe src={exhibit.embedUrl} title={exhibit.title} loading="lazy" allow="fullscreen"></iframe>
        </div>
        <p class="embed-note">
          <a href={exhibit.embedUrl} target="_blank" rel="noopener noreferrer">Open in new tab ↗</a>
        </p>
      </section>
    )}

    {!exhibit.embedUrl && exhibit.playUrl && (
      <section class="section">
        <div class="embed">
          <iframe src={exhibit.playUrl} title={exhibit.title} loading="lazy" allow="fullscreen"></iframe>
        </div>
        <p class="embed-note"><a href={exhibit.playUrl}>Open full screen →</a></p>
      </section>
    )}

    {!exhibit.embedUrl && !exhibit.playUrl && (
      <section class="placeholder">
        <p>Interactive build coming soon.</p>
      </section>
    )}

    {relatedExhibits.length > 0 && (
      <section class="section">
        <h2 class="section-heading">Related</h2>
        <div class="row-list">
          {relatedExhibits.slice(0, 4).map((rel) => (
            <a href={`/exhibit/${rel.slug}`} class="row-link">
              <div>
                <p class="row-link__title">{rel.title}</p>
                <p class="row-link__meta">{rel.hook ?? rel.summary}</p>
              </div>
              <span class="row-link__action">Open</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <footer class="page-footer">
      <a href="/discover">Surprise me →</a>
      <a href="/learn">Collections →</a>
    </footer>
  </article>
</MuseumLayout>

<style>
  .exhibit-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .exhibit-header h1 {
    font-size: clamp(1.5rem, 4vw, 1.875rem);
    margin-bottom: 0.35rem;
  }

  .summary {
    margin: 0;
    color: var(--text-muted);
    font-size: 1rem;
    max-width: 50ch;
    line-height: 1.6;
  }

  .embed-note {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
  }

  .placeholder {
    padding: 2rem;
    margin-bottom: 1.5rem;
    text-align: center;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .placeholder p {
    margin: 0;
  }
</style>
