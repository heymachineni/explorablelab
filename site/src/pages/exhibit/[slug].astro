---
import AppLayout from '../../layouts/AppLayout.astro';
import PathBar from '../../components/PathBar.astro';
import canonicalData from '../../data/canonical.json';
import { loadExhibitMarkdown } from '../../lib/content';
import {
  collectionBySlug,
  displaySummary,
  displayTitle,
  exhibitUrl,
  relatedExhibits,
  typeLabel,
} from '../../lib/museum';
import type { Exhibit } from '../../types';

export function getStaticPaths() {
  const exhibits = canonicalData.exhibits as Exhibit[];
  return exhibits.map((exhibit) => {
    const html = loadExhibitMarkdown(exhibit.contentPath);
    return {
      params: { slug: exhibit.slug },
      props: { exhibit, html },
    };
  });
}

interface Props {
  exhibit: Exhibit;
  html: string | null;
}

const { exhibit, html } = Astro.props;
const pathSlug = Astro.url.searchParams.get('path');
const stepParam = Astro.url.searchParams.get('step');
const stepIndex = stepParam !== null ? Number(stepParam) : -1;
const path = pathSlug ? collectionBySlug(pathSlug) : undefined;

let prevHref: string | undefined;
let nextHref: string | undefined;

if (path && stepIndex >= 0) {
  if (stepIndex > 0) {
    prevHref = exhibitUrl(path.stops[stepIndex - 1], path.slug, stepIndex - 1);
  }
  if (stepIndex < path.stops.length - 1) {
    nextHref = exhibitUrl(path.stops[stepIndex + 1], path.slug, stepIndex + 1);
  }
}

const related = relatedExhibits(exhibit, 6);
---

<AppLayout
  title={displayTitle(exhibit)}
  description={displaySummary(exhibit)}
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Atlas', href: '/graph' },
    ...(path ? [{ label: path.title, href: `/collection/${path.slug}` }] : []),
    { label: displayTitle(exhibit) },
  ]}
  wide
>
  {path && stepIndex >= 0 && (
    <PathBar
      pathSlug={path.slug}
      stepIndex={stepIndex}
      pathTitle={path.title}
      total={path.stops.length}
      prevHref={prevHref}
      nextHref={nextHref}
    />
  )}

  <header class="exhibit-head">
    <div class="exhibit-head-top">
      <span class="pill pill--meta">{typeLabel(exhibit)} · {exhibit.wing}</span>
    </div>
    <h1 class="page-title">{displayTitle(exhibit)}</h1>
    <p class="page-lead">{displaySummary(exhibit)}</p>
  </header>

  {html ? (
    <article class="article-body" set:html={html} />
  ) : (
    <div class="placeholder-box">
      <p>No written explanation is available for this entry yet.</p>
    </div>
  )}

  {related.length > 0 && (
    <section class="section">
      <p class="section-label">Related</p>
      <div class="db-table">
        {related.map((rel) => (
          <a href={`/exhibit/${rel.slug}`} class="db-row">
            <div>
              <p class="db-row-title">{displayTitle(rel)}</p>
              <p class="db-row-meta">{typeLabel(rel)} · {rel.summary}</p>
            </div>
            <span class="db-row-action">Read</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {!path && (
    <footer class="path-actions">
      <a href="/graph" class="btn btn-ghost">← Atlas</a>
      <a href="/learn" class="btn">Browse paths</a>
    </footer>
  )}
</AppLayout>

<style>
  .exhibit-head {
    margin-bottom: 1.25rem;
  }

  .exhibit-head-top {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 0.625rem;
  }
</style>
