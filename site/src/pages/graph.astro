---
import AppLayout from '../layouts/AppLayout.astro';
import { displayTitle, exhibits, typeLabel, TYPE_LABELS } from '../lib/museum';

const atlasItems = exhibits.map((e) => ({
  slug: e.slug,
  title: displayTitle(e),
  type: e.type,
  typeLabel: typeLabel(e),
  wing: e.wing,
  summary: e.summary,
  href: `/exhibit/${e.slug}`,
}));

const typeFilters = Object.entries(TYPE_LABELS).map(([code, label]) => ({ code, label }));
---

<AppLayout
  title="Atlas"
  description="Search and browse all explanations."
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Atlas' }]}
  full
>
  <header class="list-header atlas-header">
    <div>
      <h1 class="list-title">Atlas</h1>
      <p class="list-lead">{exhibits.length} explanations · filter by type · <kbd>⌘K</kbd></p>
    </div>
  </header>

  <div class="atlas-toolbar">
    <input type="search" class="atlas-search" id="atlas-search" placeholder="Search…" aria-label="Search explanations" />
    <div class="filter-row" id="atlas-filters">
      <button type="button" class="filter-chip active" data-filter="all">All</button>
      {typeFilters.map(({ code, label }) => (
        <button type="button" class="filter-chip" data-filter={code}>{label}</button>
      ))}
    </div>
  </div>

  <div class="notion-table-wrap">
    <table class="notion-table notion-table--interactive" id="atlas-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Summary</th>
          <th>Type</th>
          <th>Collection</th>
        </tr>
      </thead>
      <tbody>
        {atlasItems.map((item) => (
          <tr
            class="atlas-row"
            data-type={item.type}
            data-search={`${item.title} ${item.slug} ${item.typeLabel} ${item.wing} ${item.summary}`.toLowerCase()}
          >
            <td><a href={item.href} class="table-link">{item.title}</a></td>
            <td class="table-muted">{item.summary}</td>
            <td><span class="property-pill property-pill--gray">{item.typeLabel}</span></td>
            <td><span class="property-pill property-pill--gray">{item.wing}</span></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AppLayout>

<script is:inline>
  const search = document.getElementById('atlas-search');
  const rows = Array.from(document.querySelectorAll('.atlas-row'));
  const filters = Array.from(document.querySelectorAll('.filter-chip'));
  let mode = new URLSearchParams(window.location.search).get('type') || 'all';

  function apply() {
    const q = (search?.value ?? '').trim().toLowerCase();
    rows.forEach((row) => {
      const type = row.getAttribute('data-type') ?? '';
      const hay = row.getAttribute('data-search') ?? '';
      const matchQ = !q || hay.includes(q);
      const matchF = mode === 'all' || type === mode;
      row.style.display = matchQ && matchF ? '' : 'none';
    });
  }

  function setFilter(next) {
    mode = next;
    filters.forEach((btn) => {
      btn.classList.toggle('active', (btn.getAttribute('data-filter') ?? 'all') === mode);
    });
    apply();
  }

  search?.addEventListener('input', apply);
  filters.forEach((btn) => {
    btn.addEventListener('click', () => setFilter(btn.getAttribute('data-filter') ?? 'all'));
  });
  setFilter(mode);
</script>

<style>
  .atlas-header {
    max-width: var(--content-wide);
    margin: 0 auto 1rem;
    padding: 0 clamp(1rem, 3vw, 1.5rem);
  }

  .list-header {
    margin-bottom: 0;
  }

  .list-title {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 0.35rem;
  }

  .list-lead {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }

  .list-lead kbd {
    font-family: var(--mono);
    font-size: 0.6875rem;
    padding: 0.05rem 0.3rem;
    border: 1px solid var(--border);
    border-radius: 3px;
  }

  .atlas-toolbar {
    max-width: var(--content-wide);
    margin: 0 auto 1rem;
    padding: 0 clamp(1rem, 3vw, 1.5rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .atlas-search {
    flex: 1;
    min-width: 180px;
    padding: 0.4375rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-family: var(--font);
    font-size: 0.875rem;
    background: var(--bg);
  }

  .atlas-search:focus {
    outline: none;
    border-color: var(--accent);
  }

  .filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .filter-chip {
    padding: 0.25rem 0.625rem;
    font-family: var(--font);
    font-size: 0.8125rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    color: var(--text-secondary);
    cursor: pointer;
  }

  .filter-chip:hover {
    background: var(--bg-hover);
  }

  .filter-chip.active {
    background: var(--text);
    border-color: var(--text);
    color: #fff;
  }

  .notion-table-wrap {
    max-width: var(--content-wide);
    margin: 0 auto;
    padding: 0 clamp(1rem, 3vw, 1.5rem);
  }
</style>
