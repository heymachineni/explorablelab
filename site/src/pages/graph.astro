---
import AppLayout from '../layouts/AppLayout.astro';
import { displayTitle, exhibits, isPlayable } from '../lib/museum';

const atlasItems = exhibits.map((e) => ({
  slug: e.slug,
  title: displayTitle(e),
  type: e.type,
  wing: e.wing,
  playable: isPlayable(e),
  href: isPlayable(e) ? `/exhibit/${e.slug}` : `/catalog/${e.slug}`,
  relatedCount: e.related.length,
}));
---

<AppLayout
  title="Atlas"
  description="Search and browse the exhibit catalog."
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Atlas' }]}
  full
>
  <div class="atlas-header">
    <div>
      <h1 class="page-title">Atlas</h1>
      <p class="page-lead" style="margin-bottom: 0;">
        {exhibits.length} exhibits · search, filter, and open. Press <kbd>⌘K</kbd> anywhere.
      </p>
    </div>
  </div>

  <div class="atlas-controls">
    <input type="search" class="atlas-search" id="atlas-search" placeholder="Filter exhibits…" aria-label="Filter exhibits" />
    <div class="btn-row">
      <button type="button" class="btn btn-primary atlas-filter active" data-filter="all">All</button>
      <button type="button" class="btn atlas-filter" data-filter="playable">Playable</button>
      <button type="button" class="btn atlas-filter" data-filter="catalog">Catalog only</button>
    </div>
  </div>

  <div class="db-table" id="atlas-list">
    {atlasItems.map((item) => (
      <a
        href={item.href}
        class="db-row atlas-row"
        data-playable={item.playable ? '1' : '0'}
        data-search={`${item.title} ${item.slug} ${item.type} ${item.wing}`.toLowerCase()}
      >
        <div>
          <p class="db-row-title">{item.title}</p>
          <p class="db-row-meta">{item.type} · {item.wing} · {item.relatedCount} links</p>
        </div>
        <div class="db-row-right">
          <span class:list={['pill', item.playable ? 'pill--ready' : 'pill--soon']}>
            {item.playable ? 'Play' : 'Read'}
          </span>
        </div>
      </a>
    ))}
  </div>
</AppLayout>

<script is:inline>
  const search = document.getElementById('atlas-search');
  const rows = Array.from(document.querySelectorAll('.atlas-row'));
  const filters = Array.from(document.querySelectorAll('.atlas-filter'));
  let mode = 'all';

  function apply() {
    const q = (search?.value ?? '').trim().toLowerCase();
    rows.forEach((row) => {
      const playable = row.getAttribute('data-playable') === '1';
      const hay = row.getAttribute('data-search') ?? '';
      const matchQ = !q || hay.includes(q);
      const matchF =
        mode === 'all' ||
        (mode === 'playable' && playable) ||
        (mode === 'catalog' && !playable);
      row.style.display = matchQ && matchF ? '' : 'none';
    });
  }

  search?.addEventListener('input', apply);
  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      mode = btn.getAttribute('data-filter') ?? 'all';
      filters.forEach((b) => b.classList.toggle('active', b === btn));
      filters.forEach((b) => b.classList.toggle('btn-primary', b === btn));
      apply();
    });
  });
</script>

<style>
  .atlas-header {
    max-width: var(--content-max);
    margin: 0 auto 1.25rem;
    padding: 0 clamp(1rem, 3vw, 1.5rem);
  }

  .atlas-controls {
    max-width: var(--content-max);
    margin: 0 auto 1rem;
    padding: 0 clamp(1rem, 3vw, 1.5rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .atlas-search {
    flex: 1;
    min-width: 200px;
    padding: 0.4375rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-family: var(--font);
    font-size: 0.875rem;
    background: var(--bg);
    color: var(--text);
  }

  .atlas-search:focus {
    outline: none;
    border-color: var(--accent);
  }

  #atlas-list {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .atlas-header kbd,
  .page-lead kbd {
    font-family: var(--mono);
    font-size: 0.6875rem;
    padding: 0.05rem 0.3rem;
    border: 1px solid var(--border);
    border-radius: 3px;
  }
</style>
