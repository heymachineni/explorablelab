---
import AppLayout from '../layouts/AppLayout.astro';
import DatabaseView from '../components/DatabaseView.astro';
import { exhibits } from '../lib/museum';
import { databaseRows } from '../lib/workspace';
---

<AppLayout
  title="All pages"
  description="Search and browse every explanation in the workspace."
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'All pages' }]}
  full
>
  <DatabaseView
    rows={databaseRows}
    title="All pages"
    lead={`${exhibits.length} explanations · filter by type · ⌘K for quick search`}
    showHubColumn={true}
    showDifficultyColumn={true}
    id="atlas"
  />
</AppLayout>
