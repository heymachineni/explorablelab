---
import MuseumLayout from '../layouts/MuseumLayout.astro';
import canonicalData from '../data/canonical.json';
import type { Exhibit } from '../types';

const exhibits = canonicalData.exhibits as Exhibit[];

interface GraphNode {
  slug: string;
  title: string;
  x: number;
  y: number;
}

interface GraphEdge {
  from: string;
  to: string;
}

const nodes: GraphNode[] = exhibits.map((e, i) => {
  const angle = (i / exhibits.length) * Math.PI * 2;
  const radius = 0.32 + (i % 3) * 0.06;
  return {
    slug: e.slug,
    title: e.title,
    x: 0.5 + Math.cos(angle) * radius,
    y: 0.5 + Math.sin(angle) * radius,
  };
});

const slugSet = new Set(exhibits.map((e) => e.slug));
const edges: GraphEdge[] = [];

for (const exhibit of exhibits) {
  for (const rel of exhibit.related) {
    if (slugSet.has(rel) && exhibit.slug < rel) {
      edges.push({ from: exhibit.slug, to: rel });
    }
  }
}

const graphData = { nodes, edges };
const exhibitOptions = exhibits.map((e) => ({ slug: e.slug, title: e.title }));
---

<MuseumLayout title="Constellation" description="Canonical exhibits as a graph of related ideas.">
  <header class="page-header">
    <h1>Constellation</h1>
    <p class="lead">Canonical nodes as stars — edges from related exhibits. Click a dot to visit.</p>
  </header>

  <div class="graph-container">
    <canvas id="graph-canvas" width="960" height="640" aria-label="Constellation graph of exhibits"></canvas>
    <p class="graph-legend">{nodes.length} exhibits · {edges.length} connections</p>
    <div class="graph-actions">
      <button type="button" class="graph-btn" id="rabbit-btn">Rabbit Hole →</button>
      <button type="button" class="graph-btn secondary" id="trail-btn">Save to Trail</button>
    </div>
    <p class="trail-note" id="trail-note" hidden></p>
  </div>

  <section class="compare-section">
    <h2>Compare Mode</h2>
    <p class="compare-lead">Pick two exhibits — see them side by side.</p>
    <div class="compare-picks">
      <label>
        Exhibit A
        <select id="compare-a">
          {exhibitOptions.map((e) => (
            <option value={e.slug}>{e.title}</option>
          ))}
        </select>
      </label>
      <label>
        Exhibit B
        <select id="compare-b">
          {exhibitOptions.map((e, i) => (
            <option value={e.slug} selected={i === 1}>{e.title}</option>
          ))}
        </select>
      </label>
      <button type="button" class="graph-btn" id="compare-btn">Compare →</button>
    </div>
    <div class="compare-panel" id="compare-panel" hidden>
      <div class="compare-col" id="compare-col-a"></div>
      <div class="compare-col" id="compare-col-b"></div>
    </div>
  </section>

  <script is:inline define:vars={{ graphData, exhibitCatalog: exhibits }}>
    const canvas = document.getElementById('graph-canvas');
    if (!canvas) throw new Error('Canvas not found');

    const ctx = canvas.getContext('2d');
    if (!ctx) throw new Error('2D context unavailable');

    const dpr = window.devicePixelRatio || 1;
    let width = canvas.clientWidth;
    let height = Math.min(640, width * 0.66);

    function resize() {
      width = canvas.parentElement?.clientWidth ?? 960;
      height = Math.min(640, width * 0.66);
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      draw();
    }

    const nodeMap = new Map(graphData.nodes.map((n) => [n.slug, n]));

    function draw() {
      ctx.clearRect(0, 0, width, height);

      ctx.fillStyle = '#1a1410';
      ctx.fillRect(0, 0, width, height);

      for (const edge of graphData.edges) {
        const a = nodeMap.get(edge.from);
        const b = nodeMap.get(edge.to);
        if (!a || !b) continue;
        ctx.beginPath();
        ctx.moveTo(a.x * width, a.y * height);
        ctx.lineTo(b.x * width, b.y * height);
        ctx.strokeStyle = 'rgba(224, 122, 95, 0.18)';
        ctx.lineWidth = 1;
        ctx.stroke();
      }

      for (const node of graphData.nodes) {
        const px = node.x * width;
        const py = node.y * height;
        ctx.beginPath();
        ctx.arc(px, py, 5, 0, Math.PI * 2);
        ctx.fillStyle = '#e07a5f';
        ctx.fill();
        ctx.beginPath();
        ctx.arc(px, py, 10, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(224, 122, 95, 0.15)';
        ctx.fill();
      }
    }

    canvas.addEventListener('click', (ev) => {
      const rect = canvas.getBoundingClientRect();
      const mx = ev.clientX - rect.left;
      const my = ev.clientY - rect.top;

      for (const node of graphData.nodes) {
        const px = node.x * width;
        const py = node.y * height;
        const dist = Math.hypot(mx - px, my - py);
        if (dist < 16) {
          window.location.href = `/exhibit/${node.slug}`;
          return;
        }
      }
    });

    canvas.addEventListener('mousemove', (ev) => {
      const rect = canvas.getBoundingClientRect();
      const mx = ev.clientX - rect.left;
      const my = ev.clientY - rect.top;
      let hovering = false;
      for (const node of graphData.nodes) {
        const px = node.x * width;
        const py = node.y * height;
        if (Math.hypot(mx - px, my - py) < 16) {
          hovering = true;
          canvas.title = node.title;
          break;
        }
      }
      canvas.style.cursor = hovering ? 'pointer' : 'default';
      if (!hovering) canvas.title = '';
    });

    resize();
    window.addEventListener('resize', resize);

    document.getElementById('rabbit-btn')?.addEventListener('click', () => {
      if (!graphData.nodes.length) return;
      const start = graphData.nodes[Math.floor(Math.random() * graphData.nodes.length)];
      const edge = graphData.edges.find((e) => e.from === start.slug || e.to === start.slug);
      const next = edge ? (edge.from === start.slug ? edge.to : edge.from) : start.slug;
      window.location.href = `/exhibit/${next}`;
    });

    document.getElementById('trail-btn')?.addEventListener('click', () => {
      const key = 'explorablelab-trail';
      const trail = JSON.parse(localStorage.getItem(key) || '[]');
      const slug = graphData.nodes[Math.floor(Math.random() * graphData.nodes.length)]?.slug;
      if (slug && !trail.includes(slug)) trail.push(slug);
      localStorage.setItem(key, JSON.stringify(trail.slice(-20)));
      const note = document.getElementById('trail-note');
      if (note) {
        note.hidden = false;
        note.textContent = `Trail saved (${trail.length} exhibits). Open Discover to continue.`;
      }
    });

    const catalogMap = new Map(exhibitCatalog.map((e) => [e.slug, e]));

    function renderCompareCol(el, exhibit) {
      if (!exhibit) {
        el.innerHTML = '<p>Exhibit not found.</p>';
        return;
      }
      const play = exhibit.embedUrl
        ? `<iframe src="${exhibit.embedUrl}" title="${exhibit.title}" loading="lazy"></iframe>`
        : exhibit.playUrl
          ? `<iframe src="${exhibit.playUrl}" title="${exhibit.title}" loading="lazy"></iframe>`
          : `<p class="no-play">${exhibit.summary}</p>`;
      el.innerHTML = `
        <span class="cmp-type">${exhibit.type} · ${exhibit.wing}</span>
        <h3><a href="/exhibit/${exhibit.slug}">${exhibit.title}</a></h3>
        <p>${exhibit.hook ?? exhibit.summary}</p>
        <div class="cmp-embed">${play}</div>
        <a href="/exhibit/${exhibit.slug}" class="cmp-link">Open exhibit →</a>
      `;
    }

    document.getElementById('compare-btn')?.addEventListener('click', () => {
      const a = document.getElementById('compare-a')?.value;
      const b = document.getElementById('compare-b')?.value;
      const panel = document.getElementById('compare-panel');
      if (!a || !b || !panel) return;
      renderCompareCol(document.getElementById('compare-col-a'), catalogMap.get(a));
      renderCompareCol(document.getElementById('compare-col-b'), catalogMap.get(b));
      panel.hidden = false;
      panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  </script>
</MuseumLayout>

<style>
  .page-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .page-header h1 {
    font-size: clamp(2rem, 5vw, 2.75rem);
  }

  .lead {
    color: var(--text-muted);
    max-width: 42ch;
    margin: 0 auto;
  }

  .graph-container {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem;
    box-shadow: var(--shadow);
  }

  #graph-canvas {
    display: block;
    width: 100%;
    border-radius: calc(var(--radius) - 2px);
    cursor: default;
  }

  .graph-legend {
    text-align: center;
    margin: 0.75rem 0 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .graph-actions {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .graph-btn {
    appearance: none;
    cursor: pointer;
    padding: 0.6rem 1.25rem;
    font-family: var(--sans);
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: var(--radius);
    border: none;
    background: var(--accent);
    color: var(--bg);
  }

  .graph-btn.secondary {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text);
  }

  .trail-note {
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0.75rem 0 0;
  }

  .compare-section {
    margin-top: 2.5rem;
    padding: 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .compare-section h2 {
    font-size: 1.35rem;
    margin-bottom: 0.35rem;
  }

  .compare-lead {
    color: var(--text-muted);
    margin: 0 0 1.25rem;
  }

  .compare-picks {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: flex-end;
    margin-bottom: 1.5rem;
  }

  .compare-picks label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .compare-picks select {
    min-width: 200px;
    padding: 0.5rem 0.75rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-family: var(--sans);
  }

  .compare-panel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .compare-col {
    padding: 1.25rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .cmp-type {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .compare-col h3 {
    font-size: 1.1rem;
    margin: 0.4rem 0;
  }

  .compare-col p {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0 0 0.75rem;
  }

  .cmp-embed {
    position: relative;
    aspect-ratio: 16 / 10;
    background: #0d0a08;
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: 0.75rem;
  }

  .cmp-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .no-play {
    padding: 1rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .cmp-link {
    font-size: 0.85rem;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .compare-panel {
      grid-template-columns: 1fr;
    }
  }
</style>
