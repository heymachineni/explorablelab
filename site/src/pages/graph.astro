---
import AppLayout from '../layouts/AppLayout.astro';
import { displayTitle, exhibits, typeLabel, TYPE_LABELS } from '../lib/museum';

const atlasItems = exhibits.map((e) => ({
  slug: e.slug,
  title: displayTitle(e),
  type: e.type,
  typeLabel: typeLabel(e),
  wing: e.wing,
  href: `/exhibit/${e.slug}`,
  relatedCount: e.related.length,
}));

const typeFilters = Object.entries(TYPE_LABELS).map(([code, label]) => ({ code, label }));
---

<AppLayout
  title="Atlas"
  description="Search and browse all explanations."
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Atlas' }]}
  full
>
  <div class="atlas-header">
    <div>
      <h1 class="page-title">Atlas</h1>
      <p class="page-lead" style="margin-bottom: 0;">
        {exhibits.length} explanations · search and filter by type · <kbd>⌘K</kbd>
      </p>
    </div>
  </div>

  <div class="atlas-controls">
    <input type="search" class="atlas-search" id="atlas-search" placeholder="Filter explanations…" aria-label="Filter explanations" />
    <div class="btn-row atlas-filters" id="atlas-filters">
      <button type="button" class="btn btn-primary atlas-filter active" data-filter="all">All</button>
      {typeFilters.map(({ code, label }) => (
        <button type="button" class="btn atlas-filter" data-filter={code}>{label}</button>
      ))}
    </div>
  </div>

  <div class="db-table" id="atlas-list">
    {atlasItems.map((item) => (
      <a
        href={item.href}
        class="db-row atlas-row"
        data-type={item.type}
        data-search={`${item.title} ${item.slug} ${item.typeLabel} ${item.wing}`.toLowerCase()}
      >
        <div>
          <p class="db-row-title">{item.title}</p>
          <p class="db-row-meta">{item.typeLabel} · {item.wing} · {item.relatedCount} links</p>
        </div>
        <span class="pill pill--meta">{item.typeLabel}</span>
      </a>
    ))}
  </div>
</AppLayout>

<script is:inline>
  const search = document.getElementById('atlas-search');
  const rows = Array.from(document.querySelectorAll('.atlas-row'));
  const filters = Array.from(document.querySelectorAll('.atlas-filter'));
  let mode = new URLSearchParams(window.location.search).get('type') || 'all';

  function apply() {
    const q = (search?.value ?? '').trim().toLowerCase();
    rows.forEach((row) => {
      const type = row.getAttribute('data-type') ?? '';
      const hay = row.getAttribute('data-search') ?? '';
      const matchQ = !q || hay.includes(q);
      const matchF = mode === 'all' || type === mode;
      row.style.display = matchQ && matchF ? '' : 'none';
    });
  }

  function setFilter(next) {
    mode = next;
    filters.forEach((btn) => {
      const active = (btn.getAttribute('data-filter') ?? 'all') === mode;
      btn.classList.toggle('active', active);
      btn.classList.toggle('btn-primary', active);
    });
    apply();
  }

  search?.addEventListener('input', apply);
  filters.forEach((btn) => {
    btn.addEventListener('click', () => setFilter(btn.getAttribute('data-filter') ?? 'all'));
  });
  setFilter(mode);
</script>

<style>
  .atlas-header {
    max-width: var(--content-max);
    margin: 0 auto 1.25rem;
    padding: 0 clamp(1rem, 3vw, 1.5rem);
  }

  .atlas-controls {
    max-width: var(--content-wide);
    margin: 0 auto 1rem;
    padding: 0 clamp(1rem, 3vw, 1.5rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .atlas-filters {
    flex-wrap: wrap;
  }

  .atlas-search {
    flex: 1;
    min-width: 200px;
    padding: 0.4375rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-family: var(--font);
    font-size: 0.875rem;
    background: var(--bg);
    color: var(--text);
  }

  .atlas-search:focus {
    outline: none;
    border-color: var(--accent);
  }

  #atlas-list {
    max-width: var(--content-wide);
    margin: 0 auto;
  }

  .atlas-header kbd,
  .page-lead kbd {
    font-family: var(--mono);
    font-size: 0.6875rem;
    padding: 0.05rem 0.3rem;
    border: 1px solid var(--border);
    border-radius: 3px;
  }
</style>
