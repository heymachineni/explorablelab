---
import AppLayout from '../../layouts/AppLayout.astro';
import PathBar from '../../components/PathBar.astro';
import canonicalData from '../../data/canonical.json';
import {
  collectionBySlug,
  displaySummary,
  displayTitle,
  exhibitBySlug,
  exhibitInPathUrl,
  isPlayable,
  playableExhibits,
  relatedPlayable,
} from '../../lib/museum';
import type { Exhibit } from '../../types';

export function getStaticPaths() {
  const exhibits = canonicalData.exhibits as Exhibit[];
  return exhibits
    .filter((e) => !isPlayable(e))
    .map((exhibit) => ({
      params: { slug: exhibit.slug },
      props: { exhibit },
    }));
}

interface Props {
  exhibit: Exhibit;
}

const { exhibit } = Astro.props;
const pathSlug = Astro.url.searchParams.get('path');
const stepParam = Astro.url.searchParams.get('step');
const stepIndex = stepParam !== null ? Number(stepParam) : -1;
const path = pathSlug ? collectionBySlug(pathSlug) : undefined;

let prevHref: string | undefined;
let nextHref: string | undefined;
let skipHref: string | undefined;

if (path && stepIndex >= 0) {
  if (stepIndex > 0) {
    const prevSlug = path.stops[stepIndex - 1];
    prevHref = isPlayable(exhibitBySlug(prevSlug))
      ? exhibitInPathUrl(prevSlug, path.slug, stepIndex - 1)
      : `/catalog/${prevSlug}?path=${path.slug}&step=${stepIndex - 1}`;
  }
  if (stepIndex < path.stops.length - 1) {
    const nextSlug = path.stops[stepIndex + 1];
    nextHref = isPlayable(exhibitBySlug(nextSlug))
      ? exhibitInPathUrl(nextSlug, path.slug, stepIndex + 1)
      : `/catalog/${nextSlug}?path=${path.slug}&step=${stepIndex + 1}`;
  }
  for (let i = stepIndex + 1; i < path.stops.length; i++) {
    const s = path.stops[i];
    if (isPlayable(exhibitBySlug(s))) {
      skipHref = exhibitInPathUrl(s, path.slug, i);
      break;
    }
  }
}

const related = relatedPlayable(exhibit, 3);
const playable = playableExhibits();
---

<AppLayout
  title={displayTitle(exhibit)}
  description={displaySummary(exhibit)}
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Atlas', href: '/graph' },
    ...(path ? [{ label: path.title, href: `/collection/${path.slug}` }] : []),
    { label: displayTitle(exhibit) },
  ]}
>
  {path && stepIndex >= 0 && (
    <PathBar
      pathSlug={path.slug}
      stepIndex={stepIndex}
      pathTitle={path.title}
      total={path.stops.length}
      prevHref={prevHref}
      nextHref={nextHref}
    />
  )}

  <header class="exhibit-head">
    <div class="exhibit-head-top">
      <span class="pill pill--soon">Catalog</span>
      <span class="pill pill--meta">{exhibit.type} · {exhibit.wing}</span>
    </div>
    <h1 class="page-title">{displayTitle(exhibit)}</h1>
    <p class="page-lead">{displaySummary(exhibit)}</p>
  </header>

  <div class="placeholder-box">
    <p><strong>Not playable yet.</strong> This exhibit is in the catalog — spec and context only until a simulation ships.</p>
    {skipHref && (
      <a href={skipHref} class="btn btn-primary">Skip to next playable stop →</a>
    )}
    {!skipHref && (
      <a href="/play" class="btn btn-primary">Browse playable exhibits</a>
    )}
  </div>

  {related.length > 0 && (
    <section class="section">
      <p class="section-label">Playable related ideas</p>
      <div class="db-table">
        {related.map((rel) => (
          <a href={`/exhibit/${rel.slug}`} class="db-row">
            <div>
              <p class="db-row-title">{displayTitle(rel)}</p>
              <p class="db-row-meta">{rel.summary}</p>
            </div>
            <span class="db-row-action">Play</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="section">
    <p class="section-label">Play something now</p>
    <div class="db-table">
      {playable.slice(0, 4).map((p) => (
        <a href={`/exhibit/${p.slug}`} class="db-row">
          <div>
            <p class="db-row-title">{displayTitle(p)}</p>
            <p class="db-row-meta">{p.type} · {p.wing}</p>
          </div>
          <span class="pill pill--ready">Play</span>
        </a>
      ))}
    </div>
  </section>
</AppLayout>

<style>
  .exhibit-head-top {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 0.625rem;
  }
</style>
