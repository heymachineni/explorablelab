---
import AppLayout from '../../layouts/AppLayout.astro';
import Icon from '../../components/Icon.astro';
import { iconForType } from '../../lib/icons';
import { collections, displayTitle, exhibitBySlug, exhibitUrl } from '../../lib/museum';
import type { Collection } from '../../types';

export function getStaticPaths() {
  return collections.map((collection) => ({
    params: { slug: collection.slug },
    props: { collection },
  }));
}

interface Props {
  collection: Collection;
}

const { collection } = Astro.props;
---

<AppLayout
  title={collection.title}
  description={collection.summary}
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Paths', href: '/learn' },
    { label: collection.title },
  ]}
>
  <header class="browse-header">
    <h1 class="browse-title">{collection.title}</h1>
    <p class="browse-lead">{collection.summary}</p>
  </header>

  <div class="stat-row">
    <div>
      <div class="stat-value">{collection.stops.length}</div>
      <div class="stat-label">Readings</div>
    </div>
    {collection.time_minutes > 0 && (
      <div>
        <div class="stat-value">{collection.time_minutes}m</div>
        <div class="stat-label">About</div>
      </div>
    )}
  </div>

  <div class="home-actions home-actions--spaced">
    <a href={`/exhibit/${collection.stops[0]}?path=${collection.slug}&step=0`} class="btn btn-primary">
      Start path
    </a>
  </div>

  <ul class="page-rows">
    {collection.stops.map((slug, index) => {
      const exhibit = exhibitBySlug(slug);
      const href = exhibitUrl(slug, collection.slug, index);
      return (
        <li class="page-row">
          <a href={href} class="page-row-link">
            <span class="page-row-icon">
              {exhibit ? (
                <Icon name={iconForType(exhibit.type)} size={18} />
              ) : (
                <Icon name="page" size={18} />
              )}
            </span>
            <span class="page-row-body">
              <span class="page-row-title">{index + 1}. {exhibit ? displayTitle(exhibit) : slug.replace(/-/g, ' ')}</span>
              {exhibit && <span class="page-row-summary">{exhibit.summary}</span>}
            </span>
            <Icon name="chevron-right" size={18} class="page-row-chevron" />
          </a>
        </li>
      );
    })}
  </ul>

  <footer class="doc-footer">
    <a href="/learn">All paths</a>
  </footer>
</AppLayout>
