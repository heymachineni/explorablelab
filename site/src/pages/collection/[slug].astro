---
import AppLayout from '../../layouts/AppLayout.astro';
import { collections, displayTitle, exhibitBySlug, exhibitUrl } from '../../lib/museum';
import type { Collection } from '../../types';

export function getStaticPaths() {
  return collections.map((collection) => ({
    params: { slug: collection.slug },
    props: { collection },
  }));
}

interface Props {
  collection: Collection;
}

const { collection } = Astro.props;
---

<AppLayout
  title={collection.title}
  description={collection.summary}
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Paths', href: '/learn' },
    { label: collection.title },
  ]}
>
  <h1 class="page-title">{collection.title}</h1>
  <p class="page-lead">{collection.summary}</p>

  <div class="stat-row" style="margin-bottom: 1.5rem;">
    <div class="stat-item">
      <div class="stat-value">{collection.stops.length}</div>
      <div class="stat-label">Stops</div>
    </div>
    {collection.time_minutes > 0 && (
      <div class="stat-item">
        <div class="stat-value">{collection.time_minutes}m</div>
        <div class="stat-label">Estimated time</div>
      </div>
    )}
  </div>

  <div class="btn-row" style="margin-bottom: 1.5rem;">
    <a href={`/exhibit/${collection.stops[0]}?path=${collection.slug}&step=0`} class="btn btn-primary">
      Start path
    </a>
  </div>

  <p class="section-label">Stops</p>
  <div class="db-table">
    {collection.stops.map((slug, index) => {
      const exhibit = exhibitBySlug(slug);
      const href = exhibitUrl(slug, collection.slug, index);
      return (
        <a href={href} class="db-row">
          <div>
            <p class="db-row-title">
              <span style="color: var(--text-tertiary); font-weight: 500;">{index + 1}.</span>{' '}
              {exhibit ? displayTitle(exhibit) : slug.replace(/-/g, ' ')}
            </p>
            {exhibit && <p class="db-row-meta">{exhibit.summary}</p>}
          </div>
          <span class="db-row-action">Read</span>
        </a>
      );
    })}
  </div>

  <footer class="path-actions">
    <a href="/learn" class="btn btn-ghost">← All paths</a>
  </footer>
</AppLayout>
