---
import MuseumLayout from '../../layouts/MuseumLayout.astro';
import collectionsData from '../../data/collections.json';
import canonicalData from '../../data/canonical.json';
import type { Collection, Exhibit } from '../../types';

export function getStaticPaths() {
  const collections = collectionsData.collections as Collection[];
  return collections.map((collection) => ({
    params: { slug: collection.slug },
    props: { collection },
  }));
}

interface Props {
  collection: Collection;
}

const { collection } = Astro.props;
const exhibits = canonicalData.exhibits as Exhibit[];

function resolveStop(slug: string) {
  return exhibits.find((e) => e.slug === slug);
}
---

<MuseumLayout title={collection.title} description={collection.summary}>
  <header class="page-header">
    <p class="meta">Collection</p>
    <h1>{collection.title}</h1>
    <p class="lead">{collection.summary}</p>
    <p class="meta collection-meta">
      {collection.time_minutes > 0 ? `~${collection.time_minutes} min` : 'Reference'} · {collection.stops.length} stops
      {collection.emotional_arc ? ` · ${collection.emotional_arc}` : ''}
    </p>
  </header>

  <ol class="stops-list">
    {collection.stops.map((slug, i) => {
      const exhibit = resolveStop(slug);
      return (
        <li>
          <a href={exhibit ? `/exhibit/${exhibit.slug}` : '#'} class="row-link stop-link">
            <div>
              <p class="row-link__title">
                <span class="stop-num">{i + 1}.</span> {exhibit?.title ?? slug}
              </p>
              <p class="row-link__meta">
                {exhibit ? (exhibit.hook ?? exhibit.summary) : 'Coming soon'}
              </p>
            </div>
            <span class="row-link__action">{exhibit ? 'Open' : '—'}</span>
          </a>
        </li>
      );
    })}
  </ol>

  <footer class="page-footer">
    <a href="/learn">← All collections</a>
    <a href="/discover">Surprise me →</a>
  </footer>
</MuseumLayout>

<style>
  .collection-meta {
    margin-top: 0.75rem;
  }

  .stops-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .stop-link {
    display: flex;
  }

  .stop-num {
    color: var(--text-faint);
    font-weight: 500;
  }
</style>
