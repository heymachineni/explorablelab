---
import AppLayout from '../layouts/AppLayout.astro';
import Icon from '../components/Icon.astro';
import { stats } from '../lib/museum';

const repo = 'https://github.com/heymachineni/explorablelab/blob/main';

const links = [
  { title: 'E.C.H.O. Studio', desc: 'Design worksheet for new simulations.', href: '/studio/echo', local: true, icon: 'contribute' as const },
  { title: 'Contributing guide', desc: 'How to promote pages and write paths.', href: `${repo}/CONTRIBUTING.md`, local: false, icon: 'page' as const },
  { title: 'Content growth', desc: 'Quality bar and promotion workflow.', href: `${repo}/CONTENT-GROWTH.md`, local: false, icon: 'page' as const },
];
---

<AppLayout
  title="Contribute"
  description="Workshop documentation for contributors."
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Contribute' }]}
>
  <header class="browse-header">
    <h1 class="browse-title">Contribute</h1>
    <p class="browse-lead">
      The public site has {stats.total} curated readings and {stats.paths} paths.
      Contributors write in the markdown workshop.
    </p>
  </header>

  <ul class="page-rows">
    {links.map((link) => (
      <li class="page-row">
        <a
          href={link.href}
          class="page-row-link"
          target={link.local ? undefined : '_blank'}
          rel={link.local ? undefined : 'noopener noreferrer'}
        >
          <span class="page-row-icon">
            <Icon name={link.icon} size={18} />
          </span>
          <span class="page-row-body">
            <span class="page-row-title">{link.title}</span>
            <span class="page-row-summary">{link.desc}</span>
          </span>
          <Icon name={link.local ? 'chevron-right' : 'external'} size={18} class="page-row-chevron" />
        </a>
      </li>
    ))}
  </ul>

  <section class="section-block">
    <h2 class="home-section-title">Weekly rhythm</h2>
    <ul class="prose-list">
      <li>Promote one page to canonical quality</li>
      <li>Improve one explanation in the workshop</li>
      <li>Update one path with accurate stops</li>
    </ul>
  </section>
</AppLayout>
