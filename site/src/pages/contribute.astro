---
import AppLayout from '../layouts/AppLayout.astro';
import { stats } from '../lib/museum';

const repo = 'https://github.com/heymachineni/explorablelab/blob/main';

const links = [
  { title: 'E.C.H.O. Studio', desc: 'Design worksheet for new simulations.', href: '/studio/echo', local: true },
  { title: 'Contributing guide', desc: 'How to promote exhibits and write paths.', href: `${repo}/CONTRIBUTING.md` },
  { title: 'Canonical registry', desc: 'The 105 slugs on the museum floor.', href: `${repo}/meta/CANONICAL-REGISTRY.md` },
  { title: 'Product spec', desc: 'Vision, IA, and quality bar.', href: `${repo}/PRODUCT-SPEC.md` },
  { title: 'Design bible', desc: 'Patterns, autopsies, build specs.', href: `${repo}/EXPLORABLE_EXPLANATIONS_RESEARCH.md` },
];
---

<AppLayout
  title="Contribute"
  description="Workshop documentation for contributors."
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Contribute' }]}
>
  <h1 class="page-title">Contribute</h1>
  <p class="page-lead">
    Visitors see the museum floor — {stats.playable} playable exhibits and curated paths.
    Contributors work in the markdown workshop to promote, build, and connect ideas.
  </p>

  <p class="section-label">Workshop</p>
  <div class="db-table">
    {links.map((link) => (
      <a
        href={link.href}
        class="db-row"
        target={link.local ? undefined : '_blank'}
        rel={link.local ? undefined : 'noopener noreferrer'}
      >
        <div>
          <p class="db-row-title">{link.title}</p>
          <p class="db-row-meta">{link.desc}</p>
        </div>
        <span class="db-row-action">{link.local ? 'Open' : 'GitHub ↗'}</span>
      </a>
    ))}
  </div>

  <section class="section" style="margin-top: 2rem;">
    <p class="section-label">Weekly rhythm</p>
    <ul class="rhythm-list">
      <li>Promote one exhibit to canonical quality</li>
      <li>Ship or improve one playable simulation</li>
      <li>Update one path with accurate playable counts</li>
    </ul>
  </section>
</AppLayout>

<style>
  .rhythm-list {
    margin: 0;
    padding-left: 1.25rem;
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.7;
  }
</style>
