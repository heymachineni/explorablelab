---
import MuseumLayout from '../layouts/MuseumLayout.astro';

const repoBase = 'https://github.com/heymachineni/explorablelab/blob/main';

const workshopLinks = [
  { title: 'E.C.H.O. Studio', desc: 'Design worksheet for new explorables.', href: '/studio/echo', local: true },
  { title: 'Contributing Guide', desc: 'Promote exhibits and write collections.', href: `${repoBase}/CONTRIBUTING.md` },
  { title: 'Agent Guide', desc: 'AI workflows for canonical edits.', href: `${repoBase}/AGENT_GUIDE.md` },
  { title: 'Canonical Registry', desc: '105 slugs on the museum floor.', href: `${repoBase}/meta/CANONICAL-REGISTRY.md` },
  { title: 'Product Spec', desc: 'Vision and information architecture.', href: `${repoBase}/PRODUCT-SPEC.md` },
  { title: 'Design Bible', desc: 'Patterns, autopsies, E.C.H.O.', href: `${repoBase}/EXPLORABLE_EXPLANATIONS_RESEARCH.md` },
];
---

<MuseumLayout title="Contribute" description="Workshop docs for contributors.">
  <header class="page-header">
    <h1>Contribute</h1>
    <p class="lead">Public museum floor + contributor workshop. New work goes to canonical promotion and built interactives.</p>
  </header>

  <div class="row-list">
    {workshopLinks.map((link) => (
      <a
        href={link.href}
        class="row-link"
        target={link.local ? undefined : '_blank'}
        rel={link.local ? undefined : 'noopener noreferrer'}
      >
        <div>
          <p class="row-link__title">{link.title}</p>
          <p class="row-link__meta">{link.desc}</p>
        </div>
        <span class="row-link__action">{link.local ? 'Open' : 'GitHub ↗'}</span>
      </a>
    ))}
  </div>

  <section class="section rhythm">
    <h2 class="section-heading">Weekly rhythm</h2>
    <ul class="rhythm-list">
      <li>One canonical promotion</li>
      <li>One collection touch-up</li>
      <li>Graph link fixes on canonical set only</li>
    </ul>
  </section>
</MuseumLayout>

<style>
  .rhythm-list {
    margin: 0;
    padding-left: 1.25rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .rhythm-list li {
    margin-bottom: 0.25rem;
  }
</style>
