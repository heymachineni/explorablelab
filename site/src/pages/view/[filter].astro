---
export function getStaticPaths() {
  return [
    { params: { filter: 'theories' } },
    { params: { filter: 'patterns' } },
    { params: { filter: 'hubs' } },
  ];
}

const { filter } = Astro.params;
const map: Record<string, string> = {
  theories: 'THY',
  patterns: 'PAT',
  hubs: 'DIS',
};
return Astro.redirect(`/browse?filter=${map[filter ?? ''] ?? 'all'}`);
---
