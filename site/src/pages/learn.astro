---
import AppLayout from '../layouts/AppLayout.astro';
import { collections } from '../lib/museum';

const sorted = [...collections].sort((a, b) => {
  if (a.slug === 'start-here-first-visit') return -1;
  if (b.slug === 'start-here-first-visit') return 1;
  return (b.time_minutes || 0) - (a.time_minutes || 0);
});
---

<AppLayout
  title="Paths"
  description="Curated reading paths through ExplorableLab."
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Paths' }]}
  wide
>
  <header class="list-header">
    <h1 class="list-title">Paths</h1>
    <p class="list-lead">Curated reading sequences — ordered stops with time estimates.</p>
  </header>

  <div class="notion-table-wrap">
    <table class="notion-table notion-table--interactive">
      <thead>
        <tr>
          <th>Path</th>
          <th>Summary</th>
          <th>Time</th>
          <th>Stops</th>
        </tr>
      </thead>
      <tbody>
        {sorted.map((path) => (
          <tr>
            <td>
              <a href={`/collection/${path.slug}`} class="table-link">{path.title}</a>
            </td>
            <td class="table-muted">{path.summary}</td>
            <td>{path.time_minutes > 0 ? `${path.time_minutes} min` : '—'}</td>
            <td>{path.stops.length}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AppLayout>

<style>
  .list-header {
    margin-bottom: 1.5rem;
  }

  .list-title {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 0.35rem;
  }

  .list-lead {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }
</style>
