---
import MuseumLayout from '../layouts/MuseumLayout.astro';
import collectionsData from '../data/collections.json';
import type { Collection } from '../types';

const collections = collectionsData.collections as Collection[];
---

<MuseumLayout title="Learn" description="Curated collections and guided paths.">
  <header class="page-header">
    <h1>Learn</h1>
    <p class="lead">Curated paths with time estimates — not alphabetical lists.</p>
  </header>

  <div class="row-list">
    {collections.map((col) => (
      <a href={`/collection/${col.slug}`} class="row-link">
        <div>
          <p class="row-link__title">{col.title}</p>
          <p class="row-link__meta">
            {col.time_minutes > 0 ? `${col.time_minutes} min` : 'Reference'} · {col.stops.length} stops
            {col.emotional_arc ? ` · ${col.emotional_arc}` : ''}
          </p>
        </div>
        <span class="row-link__action">Open →</span>
      </a>
    ))}
  </div>
</MuseumLayout>
