---
import AppLayout from '../layouts/AppLayout.astro';
import Icon from '../components/Icon.astro';
import { collections } from '../lib/museum';

const sorted = [...collections].sort((a, b) => {
  if (a.slug === 'start-here-first-visit') return -1;
  if (b.slug === 'start-here-first-visit') return 1;
  return (b.time_minutes || 0) - (a.time_minutes || 0);
});
---

<AppLayout
  title="Paths"
  description="Curated reading sequences through ExplorableLab."
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Paths' }]}
>
  <header class="browse-header">
    <h1 class="browse-title">Paths</h1>
    <p class="browse-lead">Curated sequences — read in order, at your pace.</p>
  </header>

  <ul class="path-rows">
    {sorted.map((path) => (
      <li class="path-row">
        <a href={`/collection/${path.slug}`} class="path-link">
          <Icon name="paths" size={20} />
          <span class="path-body">
            <span class="path-title">{path.title}</span>
            <span class="path-meta">
              {path.summary}
              {path.time_minutes > 0 && ` · ${path.time_minutes} min · ${path.stops.length} readings`}
            </span>
          </span>
          <Icon name="chevron-right" size={18} />
        </a>
      </li>
    ))}
  </ul>
</AppLayout>
