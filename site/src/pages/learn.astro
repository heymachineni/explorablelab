---
import AppLayout from '../layouts/AppLayout.astro';
import { collections } from '../lib/museum';

const sorted = [...collections].sort((a, b) => {
  if (a.slug === 'start-here-first-visit') return -1;
  if (b.slug === 'start-here-first-visit') return 1;
  return (b.time_minutes || 0) - (a.time_minutes || 0);
});
---

<AppLayout
  title="Paths"
  description="Curated reading paths through ExplorableLab."
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Paths' }]}
>
  <h1 class="page-title">Paths</h1>
  <p class="page-lead">
    Curated reading sequences — each path lists stops in order with time estimates.
    Every stop is a read-only explanation from our corpus.
  </p>

  <div class="db-table">
    {sorted.map((path) => (
      <a href={`/collection/${path.slug}`} class="db-row">
        <div>
          <p class="db-row-title">{path.title}</p>
          <p class="db-row-meta">
            {path.time_minutes > 0 ? `${path.time_minutes} min` : 'Reference'} · {path.stops.length} stops
            {path.emotional_arc ? ` · ${path.emotional_arc}` : ''}
          </p>
        </div>
        <span class="db-row-action">Open</span>
      </a>
    ))}
  </div>
</AppLayout>
