---
import MuseumLayout from '../layouts/MuseumLayout.astro';
import canonicalData from '../data/canonical.json';
import type { Exhibit } from '../types';

const exhibits = canonicalData.exhibits as Exhibit[];
const slugs = exhibits.map((e) => e.slug);
---

<MuseumLayout title="Discover" description="Random canonical exhibit.">
  <header class="page-header page-header--center">
    <h1>Discover</h1>
    <p class="lead">Pick a random exhibit from the museum floor.</p>
  </header>

  <section class="discover-stage">
    <p class="discover-count">{slugs.length} exhibits</p>
    <button type="button" class="btn btn-primary discover-btn" id="surprise-btn">
      Surprise me
    </button>
    <p class="discover-hint" id="discover-hint" aria-live="polite"></p>
  </section>

  <script is:inline define:vars={{ exhibitSlugs: slugs }}>
    const btn = document.getElementById('surprise-btn');
    const hint = document.getElementById('discover-hint');

    btn?.addEventListener('click', () => {
      if (!exhibitSlugs.length) return;
      const slug = exhibitSlugs[Math.floor(Math.random() * exhibitSlugs.length)];
      if (hint) hint.textContent = 'Opening…';
      window.location.href = `/exhibit/${slug}`;
    });
  </script>
</MuseumLayout>

<style>
  .discover-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 3rem 0;
    text-align: center;
  }

  .discover-count {
    margin: 0;
    font-size: 0.875rem;
    color: var(--text-faint);
  }

  .discover-btn {
    padding: 0.625rem 1.5rem;
    font-size: 0.9375rem;
  }

  .discover-hint {
    margin: 0;
    min-height: 1.25rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
</style>
